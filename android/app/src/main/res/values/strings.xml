    <!-- Dynamic XFA (#456/#457): a form built to be filled in Adobe Reader, which MegaPDF
         can't do. A calm, persistent banner on the document, not a dialog and not a snackbar:
         it stays up for as long as the document is open. Viewing, saving, sharing, exporting
         and every page tool are unaffected; only filling explains rather than acting. -->
    <string name="dynamic_xfa_banner_title">Built for Adobe Reader</string>
    <string name="dynamic_xfa_banner_body">This form is designed to be filled in using Adobe Reader. MegaPDF can\'t fill it in, but you can still view, save, share and export it.</string>
    <string name="dynamic_xfa_get_reader">Get Adobe Reader</string>
    <!-- The same address the form's own placeholder page points to (Adobe's stable short link). -->
    <string name="dynamic_xfa_reader_url" translatable="false">https://www.adobe.com/go/reader_download</string>
    <!-- Arming Sign or Add text on this document (#457): explains rather than acting. -->
    <string name="dynamic_xfa_fill_notice">This form can only be filled in using Adobe Reader.</string>

    <!-- Digital signature (#476/#481): MegaPDF's save rewrites the whole file, which always
         invalidates an existing signature (measured 33/33 on real signed documents) — so
         overwriting a signed original warns at the point of Save rather than on open, and
         steers to Save a copy, which is already safe (the signed original is untouched).
         Nothing is refused: overwriting is still offered, one deliberate tap away. -->
    <string name="signed_overwrite_title">This will invalidate the signature</string>
    <string name="signed_overwrite_body">MegaPDF rewrites the whole file when it saves, so the document\'s digital signature will no longer verify once you save here. Save a copy instead to leave the signed original untouched.</string>
    <!-- The stronger case (#481): a certification (/DocMDP) signature can forbid modification
         outright, not merely be invalidated by it — the common case on real signed documents. -->
    <string name="signed_overwrite_title_certified">This document does not allow changes</string>
    <string name="signed_overwrite_body_certified">This document was certified not to be modified — its author declared that no changes are allowed at all. Saving here will break that certification as well as the signature. Save a copy instead to leave the signed original untouched.</string>
    <!-- Shown once, quietly, after Save a copy of a signed document (#481): the copy is not
         itself signed, but the original this came from was never touched. -->
    <string name="signed_copy_notice">Saved. The signature doesn\'t carry over to a copy.</string>

