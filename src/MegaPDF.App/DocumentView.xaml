<UserControl
    x:Class="MegaPDF.App.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MegaPDF.App">

    <!--
        One tab's pages area (#348 phase 1). Everything here is per document: the page
        list, the inline editor, the selection chrome, the rubber band, the hover
        overlay, the find bar, the page busy spinner and the focus ring. A DocumentView
        is created once per tab and never rebound to a different DocumentViewModel — its
        ViewModel property (a DependencyProperty, the same pattern SignatureLibraryPanel
        already uses) is set once by MainWindow.xaml's TabView item template and never
        changes for the life of the tab.

        The empty-state "no document open" screen (recents, the drop hint) is not here:
        it is shown by MainWindow over the whole TabView when the shell has no tabs at
        all, not per tab (plan §4).
    -->
    <UserControl.Resources>
        <!-- The keyboard focus ring on a page region (SDD §2.2, #2; DocumentView.Keyboard.cs).
             The system focus-visual pair, so a high-contrast theme swaps in its own
             colours; ThemeResource in a style setter follows theme changes live. -->
        <Style x:Key="PageFocusRingOuterStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource FocusStrokeColorOuterBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="PageFocusRingInnerStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource FocusStrokeColorInnerBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <!-- The page-indicator pill's ordinary ground and ink (#504). In styles rather
             than as inline attributes so that reading mode's page colours can be set as
             local values and then *cleared* again: a ThemeResource in a style setter
             keeps following the theme afterwards, where a brush put back by hand would
             still be the light one after Windows switched the app to dark. -->
        <Style x:Key="PageIndicatorPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ReadingBarLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ReadingBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="{ThemeResource TypeCaption}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="DocumentAreaRoot">

        <!-- A tab stop (SDD §2.2, #2): Tab onto the pages lands on the first field,
             checkbox or line of the page on screen, and walks on from there. Focus
             stays here while the ring moves; see DocumentView.Keyboard.cs. -->
        <ScrollViewer
            x:Name="PagesScroll"
            x:Uid="PagesScroll"
            AutomationProperties.AutomationId="PagesScroll"
            IsTabStop="True"
            GettingFocus="OnPagesGettingFocus"
            GotFocus="OnPagesGotFocus"
            Visibility="{x:Bind ViewModel.DocumentVisibility, Mode=OneWay}"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            ViewChanged="OnPagesScrollViewChanged"
            PointerWheelChanged="OnPagesPointerWheel">
            <ItemsControl x:Name="PagesItems" ItemsSource="{x:Bind ViewModel.Pages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{ThemeResource SpaceL}" Padding="24" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PageView">
                        <local:PageCanvas
                            Width="{x:Bind Width}"
                            Height="{x:Bind Height}"
                            Background="White"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            AutomationProperties.Name="{x:Bind AccessibleName}"
                            Loaded="OnPageCanvasLoaded"
                            Tapped="OnPageTapped"
                            DoubleTapped="OnPageDoubleTapped"
                            PointerPressed="OnPagePointerPressed"
                            PointerReleased="OnPagePointerReleased"
                            PointerMoved="OnPagePointerMoved"
                            PointerExited="OnPagePointerExited">
                            <Image Source="{x:Bind Source}" Stretch="Uniform" />
                            <!-- A page the engine refused to rasterise says so (#93) rather than
                                 staying a blank sheet the user cannot tell from "still loading". -->
                            <TextBlock
                                Text="{x:Bind FailedMessage}"
                                Visibility="{x:Bind FailedVisibility}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Margin="24"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <!-- Find-match highlights (issue #26); Grid panel so Margin positions each rect. -->
                            <ItemsControl ItemsSource="{x:Bind Highlights}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:SearchHighlight">
                                        <Rectangle
                                            Width="{x:Bind Width}"
                                            Height="{x:Bind Height}"
                                            Margin="{x:Bind Margin}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Fill="{x:Bind Fill}"
                                            Stroke="{x:Bind Stroke}"
                                            StrokeThickness="{x:Bind StrokeThickness}"
                                            RadiusX="1.5"
                                            RadiusY="1.5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </local:PageCanvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- These InfoBars float over the document page, not over app chrome,
             and InfoBar's severity backgrounds are translucent: #80F6F6F6 in
             light, #08FFFFFF in dark. Over a white PDF page the light one
             survives by luck and the dark one does not — 3% white over white
             paper, with white text on it, so the message is invisible (#87).
             An opaque background makes them chrome, which is what the find bar
             below already does. -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24" Spacing="{ThemeResource SpaceS}">
            <InfoBar
                x:Uid="FontNoticeBar"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                IsOpen="{x:Bind ViewModel.IsFontNoticeOpen, Mode=TwoWay}"
                Severity="Informational"
                IsClosable="True" />
            <InfoBar
                x:Uid="ScannedHintBar"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                IsOpen="{x:Bind ViewModel.IsScannedHintOpen, Mode=TwoWay}"
                Severity="Informational"
                IsClosable="True" />
            <!-- Document security (#131, ADR-004 §3, §7): a restricted open says so
                 and offers the owner password; a password open says crash recovery
                 is off; the Password command reports what it did. -->
            <InfoBar
                x:Uid="RestrictedNoticeBar"
                AutomationProperties.AutomationId="RestrictedNoticeBar"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                IsOpen="{x:Bind ViewModel.IsRestrictedNoticeOpen, Mode=TwoWay}"
                Severity="Informational"
                IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Uid="UnlockButton" Click="OnUnlockClicked" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Uid="RecoveryOffNoticeBar"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                IsOpen="{x:Bind ViewModel.IsRecoveryOffNoticeOpen, Mode=TwoWay}"
                Severity="Informational"
                IsClosable="True" />
            <!-- Dynamic XFA (#456, #457): the document opens, reports a plausible page
                 count and draws a page, but that page is Adobe's own "please wait,
                 install Adobe Reader" placeholder — the real form is an XFA template
                 built at open time in Acrobat, which PDFium never renders. Everything
                 else keeps working; only filling it in doesn't, because there is
                 nothing here to fill. Closable like the notices above, but
                 SelectSignatureForPlacement reopens it rather than silently arming a
                 tool that would land on nothing. -->
            <InfoBar
                x:Uid="DynamicXfaNoticeBar"
                AutomationProperties.AutomationId="DynamicXfaNoticeBar"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                IsOpen="{x:Bind ViewModel.IsDynamicXfaNoticeOpen, Mode=TwoWay}"
                Severity="Informational"
                IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Uid="GetAdobeReaderButton" Click="OnGetAdobeReaderClicked" AutomationProperties.AutomationId="GetAdobeReaderButton" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                IsOpen="{x:Bind ViewModel.IsSecurityNoticeOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.SecurityNotice, Mode=OneWay}"
                Severity="Success"
                IsClosable="True" />
            <!-- What a redaction removed (#173). The view model has said this since the
                 feature landed; on Windows nothing showed it, so a redaction finished in
                 silence. -->
            <InfoBar
                AutomationProperties.AutomationId="RedactionSummaryBar"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                IsOpen="{x:Bind ViewModel.IsRedactionSummaryOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.RedactionSummaryText, Mode=OneWay}"
                Severity="Success"
                IsClosable="True" />
        </StackPanel>

        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="24,12" Spacing="{ThemeResource SpaceS}">
            <InfoBar
                AutomationProperties.AutomationId="PlacementHintBar"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                Visibility="{x:Bind ViewModel.PlacementHintVisibility, Mode=OneWay}"
                IsOpen="True"
                Severity="Informational"
                Message="{x:Bind ViewModel.PlacementHint, Mode=OneWay}"
                CloseButtonClick="OnCancelPlacementClicked" />
        </StackPanel>

        <!-- Which page is in view (#144) — and, in reading mode, the floating bar the
             page-indicator pill grows into (#504, plan §4 "Windows").

             One control in two shapes rather than two controls: the pill is already
             where the bar belongs, already says which page you are on, and already
             appears and disappears with the document. In reading mode it moves to the
             bottom centre, takes a Fluent acrylic ground and radius.control 4
             (docs/design-tokens.md §3), becomes hit-testable, and shows the rest of
             its buttons. Out of it, everything but the page number is Collapsed —
             collapsed, not merely invisible, so none of it is in the tab order of the
             ordinary document view either (DocumentView.ReadingMode.cs).

             The bar is per tab because the pill is: only the active tab's DocumentView
             is on screen, so the active tab's pill is the window's reading bar, and a
             tab switch inside the mode hands it over (MainWindow.ReadingMode.cs). -->
        <Border
            x:Name="PageIndicatorPill"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,28,14"
            Padding="10,3"
            CornerRadius="12"
            IsHitTestVisible="False"
            Style="{StaticResource PageIndicatorPillStyle}"
            Visibility="{x:Bind ViewModel.DocumentVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceXs}" VerticalAlignment="Center">
                <!-- Which file, when more than one tab is open (plan §2: with one tab the
                     window title already says it). -->
                <TextBlock
                    x:Name="ReadingFileName"
                    Visibility="Collapsed"
                    Margin="4,0,8,0"
                    MaxWidth="220"
                    TextTrimming="CharacterEllipsis"
                    Style="{StaticResource ReadingBarLabelStyle}" />
                <Button x:Name="ReadingPreviousButton" Click="OnReadingPreviousClicked"
                        Style="{StaticResource ReadingBarButtonStyle}"
                        Content="&#xE70E;" FontFamily="{StaticResource SymbolThemeFontFamily}"
                        AutomationProperties.AutomationId="ReadingPreviousButton" />
                <!-- Out of reading mode this is the pill's whole content; in it, the
                     number becomes the button that opens "go to page". -->
                <TextBlock
                    x:Name="PageIndicatorText"
                    Text="{x:Bind ViewModel.PageIndicator, Mode=OneWay}"
                    Style="{StaticResource ReadingBarLabelStyle}" />
                <Button x:Name="ReadingPageButton"
                        Style="{StaticResource ReadingBarButtonStyle}"
                        Content="{x:Bind ViewModel.PageIndicator, Mode=OneWay}"
                        AutomationProperties.AutomationId="ReadingPageButton">
                    <Button.Flyout>
                        <Flyout x:Name="ReadingPageFlyout" Placement="Top">
                            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                                <TextBox x:Name="ReadingPageBox" MinWidth="72" IsSpellCheckEnabled="False"
                                         KeyDown="OnReadingPageBoxKeyDown"
                                         AutomationProperties.AutomationId="ReadingPageBox" />
                                <Button x:Name="ReadingGoButton" Click="OnReadingGoClicked"
                                        AutomationProperties.AutomationId="ReadingGoButton" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ReadingNextButton" Click="OnReadingNextClicked"
                        Style="{StaticResource ReadingBarButtonStyle}"
                        Content="&#xE70D;" FontFamily="{StaticResource SymbolThemeFontFamily}"
                        AutomationProperties.AutomationId="ReadingNextButton" />
                <!-- The zoom presets (#510): the same commands the toolbar's zoom menu
                     runs, on the bar the toolbar is no longer there to offer them from. -->
                <Button x:Name="ReadingFitWidthButton" Click="OnReadingFitWidthClicked"
                        Style="{StaticResource ReadingBarButtonStyle}" Margin="8,0,0,0"
                        Content="&#xE9A6;" FontFamily="{StaticResource SymbolThemeFontFamily}"
                        AutomationProperties.AutomationId="ReadingFitWidthButton" />
                <Button x:Name="ReadingFitPageButton" Click="OnReadingFitPageClicked"
                        Style="{StaticResource ReadingBarButtonStyle}"
                        Content="&#xE740;" FontFamily="{StaticResource SymbolThemeFontFamily}"
                        AutomationProperties.AutomationId="ReadingFitPageButton" />
                <Button x:Name="ReadingZoomOutButton" Click="OnReadingZoomOutClicked"
                        Style="{StaticResource ReadingBarButtonStyle}"
                        Content="&#xE738;" FontFamily="{StaticResource SymbolThemeFontFamily}"
                        AutomationProperties.AutomationId="ReadingZoomOutButton" />
                <Button x:Name="ReadingZoomInButton" Click="OnReadingZoomInClicked"
                        Style="{StaticResource ReadingBarButtonStyle}"
                        Content="&#xE710;" FontFamily="{StaticResource SymbolThemeFontFamily}"
                        AutomationProperties.AutomationId="ReadingZoomInButton" />
                <Button x:Name="ReadingExitButton" Click="OnReadingExitClicked"
                        Style="{StaticResource ReadingBarButtonStyle}" Padding="10,4" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="ReadingExitButton" />
            </StackPanel>
        </Border>

        <!-- Ctrl+F find bar: compact Edge-style overlay (issue #26 simple search) -->
        <Border
            x:Name="FindBar"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,8,24,0"
            Padding="8,8"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            PreviewKeyDown="OnFindBarKeyDown">
            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                <TextBox
                    x:Name="FindQuery"
                    x:Uid="FindQuery"
                    AutomationProperties.AutomationId="FindQuery"
                    IsSpellCheckEnabled="False"
                    MinWidth="180"
                    TextChanged="OnFindQueryChanged" />
                <TextBlock
                    Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}"
                    VerticalAlignment="Center"
                    MinWidth="64"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    AutomationProperties.LiveSetting="Polite" />
                <Button Click="OnFindPreviousClicked" IsEnabled="{x:Bind ViewModel.HasSearchResults, Mode=OneWay}" Content="&#xE70E;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="{ThemeResource TypeCaption}" x:Uid="FindPreviousButton" AutomationProperties.AutomationId="FindPreviousButton" />
                <Button Click="OnFindNextClicked" IsEnabled="{x:Bind ViewModel.HasSearchResults, Mode=OneWay}" Content="&#xE70D;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="{ThemeResource TypeCaption}" x:Uid="FindNextButton" AutomationProperties.AutomationId="FindNextButton" />
                <Button Click="OnFindCloseClicked" Content="&#xE711;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="{ThemeResource TypeCaption}" x:Uid="FindCloseButton" AutomationProperties.AutomationId="FindCloseButton" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
