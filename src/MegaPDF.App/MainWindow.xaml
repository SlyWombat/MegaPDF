<Window
    x:Class="MegaPDF.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MegaPDF.App">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- KeyboardAcceleratorPlacementMode="Hidden": every shortcut hangs off this grid
         (Ctrl+F below, the rest from InitializeAccelerators), and left on Auto WinUI gives
         the grid a tooltip of its first one. That was the stray "Ctrl+F" chip (#226): it
         surfaced when the pointer rested over the window and could outlive the More menu.
         The toolbar tooltips already name each shortcut, in the app's language. -->
    <Grid x:Name="RootGrid" SizeChanged="OnRootSizeChanged" KeyboardAcceleratorPlacementMode="Hidden"
          AllowDrop="True" DragOver="OnDocumentAreaDragOver" Drop="OnDocumentAreaDrop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindAccelerator" />
            <!-- Tab/window commands (#348 phase 1, plan §1 decision): closes the active tab,
                 or the window when it is the last one — TabView's own Ctrl+Tab, Ctrl+Shift+Tab,
                 Ctrl+1…9 and Ctrl+F4 are left as built-in. -->
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="OnCloseTabAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="N" Invoked="OnNewWindowAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- Declared first and before any Grid.Row-tagged sibling: with a CommandBar
             among those siblings, a XamlCompiler pass in this WinAppSDK toolchain
             crashes outright (not a diagnosable error) if RowDefinitions comes later,
             which it harmlessly did before this file had a CommandBar this elaborate. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The toolbar (#144): one CommandBar row, the same height at every width.

             Groups: File (Open, Save), Tools (Signatures, Add text, Whiteout, and the
             font and size pickers while there is text to style), history (Undo, Redo)
             and one zoom control (−, the level with its menu, +). Save As, Password…,
             Print, Shrink, Find and Settings live in the overflow ("…"), which is
             always there.

             Wide, labels sit to the right of the icons. When the labelled row no longer
             fits — a width measured from the items, in the running language, not a
             constant; ApplyToolbarLayout in MainWindow.Toolbar.cs — the labels go and
             every button keeps its tooltip and automation name. Narrower still, the
             CommandBar's dynamic overflow moves commands into "…" lowest
             DynamicOverflowOrder first: Redo, then zoom, then the pickers, Whiteout,
             Undo, Add text, Signatures and Save. Open never leaves.

             The shortcuts are on RootGrid rather than on the buttons, so they keep
             working for a command that has overflowed (MainWindow.Toolbar.cs).

             Every command below acts on Shell.Active — the tab the tab strip has
             selected — not on a fixed ViewModel (#348 phase 1). x:Bind defaults to
             OneTime, so every one of these is explicitly Mode=OneWay: the plan's §6.4
             sharp edge. Shell.Active can be null with zero tabs open; x:Bind null-checks
             every step of a path automatically, so these simply evaluate to null/false
             rather than throwing. -->
        <Grid
            x:Name="BusyStrip"
            Grid.Row="1"
            Visibility="{x:Bind Shell.Active.Busy.ShowsStrip, Mode=OneWay}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,6,16,4">
            <StackPanel Spacing="{ThemeResource SpaceXs}">
                <TextBlock
                    x:Name="BusyLabel"
                    Text="{x:Bind Shell.Active.Busy.Label, Mode=OneWay}"
                    FontSize="{ThemeResource TypeCaption}"
                    AutomationProperties.LiveSetting="Polite" />
                <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{x:Bind Shell.Active.Busy.Label, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <CommandBar
            x:Name="Toolbar"
            Grid.Row="0"
            HorizontalAlignment="Left"
            Margin="4,0"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True"
            OverflowButtonVisibility="Visible"
            AutomationProperties.AutomationId="Toolbar">
            <AppBarButton x:Name="OpenButton" Command="{x:Bind Shell.OpenCommand}" AccessKey="O" KeyboardAcceleratorTextOverride="Ctrl+O" DynamicOverflowOrder="100" AutomationProperties.AutomationId="OpenButton">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
            </AppBarButton>
            <!-- The visible label carries the unsaved-changes dot; the UIA name
                 stays plain "Save" so Narrator announces a stable control name. -->
            <AppBarButton x:Name="SaveButton" Command="{x:Bind Shell.Active.SaveCommand, Mode=OneWay}" Label="{x:Bind Shell.Active.SaveButtonLabel, Mode=OneWay}" AccessKey="S" KeyboardAcceleratorTextOverride="Ctrl+S" DynamicOverflowOrder="90" AutomationProperties.AutomationId="SaveButton">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator DynamicOverflowOrder="80" />

            <!-- The three editing tools follow the document's permissions (#131):
                 annotate for signatures, modify for whiteout and added text. -->
            <AppBarButton x:Name="SignaturesToolbarButton" Click="OnSignaturesClicked" IsEnabled="{x:Bind Shell.Active.IsSigningAllowed, Mode=OneWay}" DynamicOverflowOrder="80" AutomationProperties.AutomationId="SignaturesButton">
                <AppBarButton.Icon><FontIcon Glyph="&#xEE56;" /></AppBarButton.Icon>
            </AppBarButton>
            <local:ArmableAppBarButton x:Name="AddTextButton" IsArmed="{x:Bind Shell.Active.IsTextBoxMode, Mode=OneWay}" Click="OnTextBoxModeClicked" IsEnabled="{x:Bind Shell.Active.IsTextBoxAllowed, Mode=OneWay}" DynamicOverflowOrder="70" AutomationProperties.AutomationId="AddTextButton">
                <local:ArmableAppBarButton.Icon><FontIcon Glyph="&#xE8D2;" /></local:ArmableAppBarButton.Icon>
            </local:ArmableAppBarButton>
            <local:ArmableAppBarButton x:Name="WhiteoutButton" IsArmed="{x:Bind Shell.Active.IsWhiteoutMode, Mode=OneWay}" Click="OnWhiteoutModeClicked" IsEnabled="{x:Bind Shell.Active.IsEditingAllowed, Mode=OneWay}" DynamicOverflowOrder="40" AutomationProperties.AutomationId="WhiteoutButton">
                <local:ArmableAppBarButton.Icon><FontIcon Glyph="&#xE75C;" /></local:ArmableAppBarButton.Icon>
            </local:ArmableAppBarButton>
            <!-- Redact beside Whiteout, because the pair is the point (#173): one covers,
                 the other removes, and each tooltip says which. Glyph E7BA is Segoe Fluent's
                 Warning triangle, not a block-out mark: it reads as "careful", and it stays
                 for 2.0 (#146 §3). It overflows before Whiteout does, not after. -->
            <local:ArmableAppBarButton x:Name="RedactButton" IsArmed="{x:Bind Shell.Active.IsRedactMode, Mode=OneWay}" Click="OnRedactModeClicked" IsEnabled="{x:Bind Shell.Active.IsEditingAllowed, Mode=OneWay}" DynamicOverflowOrder="41" AutomationProperties.AutomationId="RedactButton">
                <local:ArmableAppBarButton.Icon><FontIcon Glyph="&#xE7BA;" /></local:ArmableAppBarButton.Icon>
            </local:ArmableAppBarButton>
            <!-- Contextual (#144): shown while Add text is armed, or an added text box is
                 selected or being edited. No formatting UI for the document's own text
                 or form fields (SDD §3.1): their formatting is inherited. -->
            <AppBarElementContainer x:Name="FontPickerItem" Visibility="Collapsed" DynamicOverflowOrder="30"
                                    VerticalContentAlignment="Center" IsTabStop="False">
                <ComboBox x:Name="FontPicker" MinWidth="116" Margin="4,0,2,0" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="FontPicker"
                          SelectionChanged="OnTextPickerChanged" DropDownClosed="OnTextPickerClosed" />
            </AppBarElementContainer>
            <AppBarElementContainer x:Name="SizePickerItem" Visibility="Collapsed" DynamicOverflowOrder="30"
                                    VerticalContentAlignment="Center" IsTabStop="False">
                <ComboBox x:Name="SizePicker" MinWidth="72" Margin="2,0,4,0" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="SizePicker"
                          SelectionChanged="OnTextPickerChanged" DropDownClosed="OnTextPickerClosed" />
            </AppBarElementContainer>
            <AppBarSeparator DynamicOverflowOrder="50" />

            <AppBarButton x:Name="UndoButton" Command="{x:Bind Shell.Active.UndoCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Z" DynamicOverflowOrder="50" AutomationProperties.AutomationId="UndoButton">
                <AppBarButton.Icon><FontIcon Glyph="&#xE7A7;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="RedoButton" Command="{x:Bind Shell.Active.RedoCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Y" DynamicOverflowOrder="10" AutomationProperties.AutomationId="RedoButton">
                <AppBarButton.Icon><FontIcon Glyph="&#xE7A6;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator DynamicOverflowOrder="20" />

            <!-- One zoom control (#144): −, the level with a menu of Actual size, the
                 two fits and preset levels, and +. Icons only, even when the row is
                 labelled: the level itself is the label. -->
            <AppBarButton x:Name="ZoomOutButton" LabelPosition="Collapsed" Command="{x:Bind Shell.Active.ZoomOutCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+−" DynamicOverflowOrder="20" AutomationProperties.AutomationId="ZoomOutButton">
                <AppBarButton.Icon><FontIcon Glyph="&#xE738;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarElementContainer x:Name="ZoomMenuItem" DynamicOverflowOrder="20"
                                    VerticalContentAlignment="Center" IsTabStop="False">
                <DropDownButton
                    x:Name="ZoomMenuButton"
                    MinWidth="80"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="{x:Bind Shell.Active.ZoomLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind Shell.Active.IsDocumentOpen, Mode=OneWay}"
                    AutomationProperties.AutomationId="ZoomMenuButton">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ZoomMenu" Placement="BottomEdgeAlignedLeft" Opening="OnZoomMenuOpening">
                            <MenuFlyoutItem x:Name="ActualSizeItem" AutomationProperties.AutomationId="ActualSizeItem" Click="OnActualSizeClicked" KeyboardAcceleratorTextOverride="Ctrl+0">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9A8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="FitWidthItem" AutomationProperties.AutomationId="FitWidthItem" Click="OnFitWidthClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9A6;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="FitPageItem" AutomationProperties.AutomationId="FitPageItem" Click="OnFitPageClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator x:Name="ZoomPresetsSeparator" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </AppBarElementContainer>
            <AppBarButton x:Name="ZoomInButton" LabelPosition="Collapsed" Command="{x:Bind Shell.Active.ZoomInCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Plus" DynamicOverflowOrder="20" AutomationProperties.AutomationId="ZoomInButton">
                <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
            </AppBarButton>

            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="SaveAsButton" Command="{x:Bind Shell.Active.SaveAsCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Shift+S" AutomationProperties.AutomationId="SaveAsButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE792;" /></AppBarButton.Icon>
                </AppBarButton>
                <!-- Set, change or remove the document's password; on a restricted
                     document, offers the owner password instead (#131, ADR-004). -->
                <AppBarButton x:Name="SecurityButton" Command="{x:Bind Shell.Active.SecurityCommand, Mode=OneWay}" AutomationProperties.AutomationId="SecurityButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72E;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="PrintButton" Click="OnPrintClicked" IsEnabled="{x:Bind Shell.Active.IsPrintAllowed, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+P" AutomationProperties.AutomationId="PrintButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE749;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ShrinkButton" Command="{x:Bind Shell.Active.ShrinkForEmailCommand, Mode=OneWay}" AutomationProperties.AutomationId="ShrinkButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE715;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="FindButton" Click="OnFindClicked" IsEnabled="{x:Bind Shell.Active.IsDocumentOpen, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+F" AutomationProperties.AutomationId="FindButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE721;" /></AppBarButton.Icon>
                </AppBarButton>
                <!-- Marks accumulate as you drag and are dropped as one step (#329), so the
                     tidying action is here rather than on the toolbar: it is not part of
                     marking. Offered only while there is something to drop. -->
                <AppBarButton x:Name="ClearMarksButton" Click="OnClearRedactionMarksClicked" IsEnabled="{x:Bind Shell.Active.HasRedactionMarks, Mode=OneWay}" AutomationProperties.AutomationId="ClearMarksButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE894;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <!-- Tab/window commands (#348 phase 1). -->
                <AppBarButton x:Name="CloseTabButton" Click="OnCloseTabClicked" IsEnabled="{x:Bind Shell.HasDocuments, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+W" AutomationProperties.AutomationId="CloseTabButton" />
                <AppBarButton x:Name="NewWindowButton" Click="OnNewWindowClicked" KeyboardAcceleratorTextOverride="Ctrl+Shift+N" AutomationProperties.AutomationId="NewWindowButton" />
                <AppBarSeparator />
                <AppBarButton x:Name="SettingsButton" Click="OnSettingsClicked" AutomationProperties.AutomationId="SettingsButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE713;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- Where the toolbar's two panels hang (#144). A flyout attached to an
             AppBarButton cannot open once that button has moved into the overflow, so
             these are shown from code at the button, or at the toolbar when it has. -->
        <Border x:Name="SignaturesFlyoutAnchor" Grid.Row="0" Width="0" Height="0"
                HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="SignaturesFlyout" Placement="BottomEdgeAlignedLeft">
                    <!-- The library itself lives in SignatureLibraryPanel (#100), shared
                         with the `sign` screenshot state's in-tree copy below. -->
                    <local:SignatureLibraryPanel
                        ViewModel="{x:Bind Shell.Active, Mode=OneWay}"
                        Picked="OnSignaturePicked"
                        RenameRequested="OnRenameSignatureRequested"
                        DeleteRequested="OnDeleteSignatureRequested"
                        DrawRequested="OnDrawSignatureClicked"
                        TypeRequested="OnTypeSignatureClicked"
                        PhotoRequested="OnAddSignatureFromImageClicked" />
                </Flyout>
            </FlyoutBase.AttachedFlyout>
        </Border>
        <Border x:Name="SettingsFlyoutAnchor" Grid.Row="0" Width="0" Height="0"
                HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="SettingsFlyout" Placement="BottomEdgeAlignedRight" Opening="OnSettingsOpening">
                    <StackPanel Spacing="{ThemeResource SpaceL}" MinWidth="230">
                        <StackPanel Spacing="{ThemeResource SpaceS}">
                            <TextBlock x:Uid="CheckboxMarkHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <RadioButtons x:Name="MarkStyleChoice" SelectionChanged="OnMarkStyleChanged">
                                <!-- TextBlocks rather than x:String items: a string cannot carry an x:Uid. -->
                                <TextBlock x:Uid="MarkCross" />
                                <TextBlock x:Uid="MarkCheck" />
                                <TextBlock x:Uid="MarkFilledSquare" />
                            </RadioButtons>
                        </StackPanel>
                        <StackPanel Spacing="{ThemeResource SpaceS}">
                            <TextBlock x:Uid="ThemeHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <RadioButtons x:Name="ThemeChoice" SelectionChanged="OnThemeChanged">
                                <TextBlock x:Uid="ThemeSystem" />
                                <TextBlock x:Uid="ThemeLight" />
                                <TextBlock x:Uid="ThemeDark" />
                            </RadioButtons>
                        </StackPanel>
                        <!-- App language (#91). Stored as a BCP-47 tag or "" for the Windows
                             display language; applied at startup, hence the note. -->
                        <StackPanel Spacing="{ThemeResource SpaceS}">
                            <TextBlock x:Uid="LanguageHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <RadioButtons x:Name="LanguageChoice" SelectionChanged="OnLanguageChanged">
                                <TextBlock x:Uid="LanguageSystem" />
                                <TextBlock x:Uid="LanguageEnglish" />
                                <TextBlock x:Uid="LanguageFrench" />
                                <TextBlock x:Uid="LanguageFrenchFrance" />
                            </RadioButtons>
                            <TextBlock x:Uid="LanguageRestartNote" x:Name="LanguageRestartNote" Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="ReopenToggle"
                            x:Uid="ReopenToggle"
                            Toggled="OnReopenToggled" />
                        <ToggleSwitch
                            x:Name="FlattenToggle"
                            x:Uid="FlattenToggle"
                            Toggled="OnFlattenToggled" />
                        <StackPanel x:Uid="AboutPanel" Spacing="{ThemeResource SpaceXs}" Margin="0,4,0,0" MaxWidth="260">
                            <TextBlock x:Uid="AboutHeading" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                            <TextBlock x:Name="AboutVersion" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Uid="AboutLicense" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                x:Uid="AboutCopyright"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                x:Uid="AboutThanks"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <HyperlinkButton
                                NavigateUri="https://github.com/SlyWombat/MegaPDF"
                                Content="github.com/SlyWombat/MegaPDF"
                                ToolTipService.ToolTip="https://github.com/SlyWombat/MegaPDF"
                                x:Uid="GitHubLink"
                                FontSize="{ThemeResource TypeCaption}"
                                Padding="0,2"
                                Margin="0,2,0,0" />
                            <HyperlinkButton
                                x:Uid="NoticesLink"
                                Click="OnThirdPartyNoticesClicked"
                                FontSize="{ThemeResource TypeCaption}"
                                Padding="0,2" />
                        </StackPanel>
                    </StackPanel>
                </Flyout>
            </FlyoutBase.AttachedFlyout>
        </Border>

        <!-- The tab strip and the tabs' pages areas (#348 phase 1). Each tab's Content is a
             DocumentView, created once by the item template and never rebound — TabView keeps
             every realized tab's content alive whether or not it is the selected one, which is
             what lets a background tab's scroll position, inline editor and selection survive
             a switch away and back without this window saving or restoring any of it. -->
        <Grid Grid.Row="2">
            <TabView
                x:Name="DocumentsTabView"
                TabItemsSource="{x:Bind Shell.Documents}"
                SelectedItem="{x:Bind Shell.Active, Mode=TwoWay}"
                CanReorderTabs="True"
                CanDragTabs="True"
                IsAddTabButtonVisible="False"
                TabCloseRequested="OnTabCloseRequested"
                SelectionChanged="OnDocumentsTabViewSelectionChanged">
                <TabView.TabItemTemplate>
                    <DataTemplate x:DataType="local:DocumentViewModel">
                        <TabViewItem
                            Header="{x:Bind TabTitle, Mode=OneWay}"
                            IsClosable="True"
                            AutomationProperties.Name="{x:Bind TabAccessibleName, Mode=OneWay}">
                            <TabViewItem.Content>
                                <local:DocumentView ViewModel="{x:Bind}" />
                            </TabViewItem.Content>
                        </TabViewItem>
                    </DataTemplate>
                </TabView.TabItemTemplate>
            </TabView>

            <!-- Empty state: zero tabs (SDD §2.2) — not per document any more (#348 phase 1).
                 Collapsed (not merely covered) when a tab is open, so it never intercepts
                 pointer input meant for the tab strip or the page beneath it. Drag-and-drop
                 is handled once, on RootGrid, which covers this and the tab strip alike. -->
            <Grid Visibility="{x:Bind Shell.EmptyStateVisibility, Mode=OneWay}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{ThemeResource SpaceM}">
                    <FontIcon Glyph="&#xE8A5;" FontSize="{ThemeResource TypeDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Uid="EmptyStateText"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center" />

                    <StackPanel Spacing="{ThemeResource SpaceXs}" Margin="0,20,0,0" Visibility="{x:Bind Shell.RecentDocumentsVisibility, Mode=OneWay}">
                        <TextBlock
                            x:Uid="RecentHeading"
                            FontSize="{ThemeResource TypeCaption}"
                            CharacterSpacing="80"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{x:Bind Shell.RecentDocuments}" HorizontalAlignment="Center" MaxWidth="420">
                            <ItemsControl.ItemTemplate>
                                <!-- Name on top, folder underneath (#165), the way Explorer and
                                     Office list recent files: the names repeat, the folders do not. -->
                                <DataTemplate x:DataType="local:RecentDocument">
                                    <HyperlinkButton
                                        Click="OnRecentDocumentClicked"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        ToolTipService.ToolTip="{x:Bind Path}"
                                        AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <HyperlinkButton.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    x:Uid="RemoveFromRecentItem"
                                                    Click="OnRemoveFromRecentClicked"
                                                    AutomationProperties.AutomationId="RemoveFromRecentItem" />
                                            </MenuFlyout>
                                        </HyperlinkButton.ContextFlyout>
                                        <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                                            <FontIcon
                                                Glyph="&#xE8A5;"
                                                FontSize="{ThemeResource TypeBody}"
                                                VerticalAlignment="Top"
                                                Margin="0,2,0,0"
                                                Opacity="{x:Bind MissingOpacity}" />
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Opacity="{x:Bind MissingOpacity}" />
                                                <TextBlock
                                                    Text="{x:Bind LocationLine}"
                                                    FontSize="{ThemeResource TypeCaption}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </HyperlinkButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- First-run "Make MegaPDF your PDF app?" card (SDD §5.4) — window-level, not
                 per tab (#348 phase 1). -->
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="24,12" Spacing="{ThemeResource SpaceS}">
                <InfoBar
                    x:Uid="DefaultAppBar"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    IsOpen="{x:Bind Shell.IsDefaultAppCardOpen, Mode=OneWay}"
                    Severity="Informational"
                    CloseButtonClick="OnDefaultAppCardClosed">
                    <InfoBar.ActionButton>
                        <Button x:Uid="ChooseDefaultAppsButton" Click="OnChooseDefaultAppsClicked" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
        </Grid>

        <!-- The signature library drawn inside the window tree, for the `sign`
             screenshot state only (#100): RenderTargetBitmap cannot see the popup
             layer a real Flyout lives in, so the capture shows this copy, styled
             as the flyout presenter and placed under the Signatures button. -->
        <Border x:Name="SignatureLibraryShot"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource FlyoutPresenterBackground}"
                BorderBrush="{ThemeResource FlyoutBorderThemeBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Padding="12">
            <local:SignatureLibraryPanel ViewModel="{x:Bind Shell.Active, Mode=OneWay}" />
        </Border>

        <!-- Offscreen host for rendering typed signatures (Segoe Script → bitmap). Window-level,
             not per tab: no document state involved, just a scratch surface (#348 phase 1).

             Grid.Row="2", the star row, where it lay before #348 (inside the pages grid): as a
             direct child of RootGrid with no row it landed in row 0, and an Auto row grows to
             its tallest child — this invisible 64 pt sample became a ~110 px band between the
             toolbar and the tab strip (#401). -->
        <Border x:Name="TypedSignatureHost" Grid.Row="2" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top">
            <!-- 64 is outside the type scale on purpose: this is sample ink at signature
                 size, not UI type. Foreground is the SDD §6.2 contract value, the same
                 #202020 a drawn signature and a check mark are stroked in. -->
            <TextBlock x:Name="TypedSignatureText" FontFamily="Segoe Script" FontSize="64"
                       Foreground="#FF202020" Padding="16,8" />
        </Border>
    </Grid>
</Window>
