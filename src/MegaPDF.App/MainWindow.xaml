<Window
    x:Class="MegaPDF.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MegaPDF.App">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" SizeChanged="OnRootSizeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- The toolbar is one row of fixed-size buttons, so on a narrow window the
             ends used to be clipped: a 1366-wide display (the Store's own minimum)
             could not show Find or the zoom controls at all. It now sheds detail in
             two steps — labels first, then the zoom cluster folds into the View
             flyout — driven by ApplyToolbarLayout in the code-behind, which is where
             the breakpoints are documented. Every button keeps its tooltip and
             AutomationProperties.Name, so the icon-only widths stay discoverable and
             Narrator reads them exactly as before.

             Done in code rather than with VisualStates because neither mechanism works
             here: AdaptiveTrigger measures a CoreWindow, which a WinUI 3 desktop window
             does not have, and VisualStateManager.GoToState needs a Control, which this
             root Grid is not. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Single slim toolbar — the app's entire command surface (SDD §2.2) -->
        <Grid x:Name="Toolbar" Grid.Row="0" Padding="8,4" ColumnSpacing="{ThemeResource SpaceXs}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{ThemeResource SpaceXs}">
                <Button Command="{x:Bind ViewModel.OpenCommand}" AccessKey="O" x:Uid="OpenButton" AutomationProperties.AutomationId="OpenButton">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                        <FontIcon Glyph="&#xE8E5;" FontSize="{ThemeResource TypeSubtitle}" />
                        <TextBlock x:Name="LabelOpen" x:Uid="LabelOpen" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </Button.KeyboardAccelerators>
                </Button>

                <!-- The visible label carries the unsaved-changes dot; the UIA name
                     stays plain "Save" so Narrator announces a stable control name. -->
                <Button Command="{x:Bind ViewModel.SaveCommand}" AccessKey="S" x:Uid="SaveButton" AutomationProperties.AutomationId="SaveButton">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                        <FontIcon Glyph="&#xE74E;" FontSize="{ThemeResource TypeSubtitle}" />
                        <TextBlock x:Name="LabelSave" Text="{x:Bind ViewModel.SaveButtonLabel, Mode=OneWay}" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                    </Button.KeyboardAccelerators>
                </Button>

                <Button Command="{x:Bind ViewModel.SaveAsCommand}" x:Uid="SaveAsButton" AutomationProperties.AutomationId="SaveAsButton">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                        <FontIcon Glyph="&#xE792;" FontSize="{ThemeResource TypeSubtitle}" />
                        <TextBlock x:Name="LabelSaveAs" x:Uid="LabelSaveAs" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                    </Button.KeyboardAccelerators>
                </Button>

                <Button Command="{x:Bind ViewModel.ShrinkForEmailCommand}" x:Uid="ShrinkButton" AutomationProperties.AutomationId="ShrinkButton">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                        <FontIcon Glyph="&#xE715;" FontSize="{ThemeResource TypeSubtitle}" />
                        <TextBlock x:Name="LabelShrink" x:Uid="LabelShrink" />
                    </StackPanel>
                </Button>

                <Button Click="OnPrintClicked" IsEnabled="{x:Bind ViewModel.IsDocumentOpen, Mode=OneWay}" x:Uid="PrintButton" AutomationProperties.AutomationId="PrintButton">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                        <FontIcon Glyph="&#xE749;" FontSize="{ThemeResource TypeSubtitle}" />
                        <TextBlock x:Name="LabelPrint" x:Uid="LabelPrint" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="P" />
                    </Button.KeyboardAccelerators>
                </Button>

                <AppBarSeparator />

                <Button Command="{x:Bind ViewModel.UndoCommand}" x:Uid="UndoButton" AutomationProperties.AutomationId="UndoButton">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                        <FontIcon Glyph="&#xE7A7;" FontSize="{ThemeResource TypeSubtitle}" />
                        <TextBlock x:Name="LabelUndo" x:Uid="LabelUndo" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z" />
                    </Button.KeyboardAccelerators>
                </Button>

                <Button Command="{x:Bind ViewModel.RedoCommand}" x:Uid="RedoButton" AutomationProperties.AutomationId="RedoButton">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                        <FontIcon Glyph="&#xE7A6;" FontSize="{ThemeResource TypeSubtitle}" />
                        <TextBlock x:Name="LabelRedo" x:Uid="LabelRedo" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Y" />
                    </Button.KeyboardAccelerators>
                </Button>

                <AppBarSeparator />

                <Button x:Uid="SignaturesButton" AutomationProperties.AutomationId="SignaturesButton">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                        <FontIcon Glyph="&#xEE56;" FontSize="{ThemeResource TypeSubtitle}" />
                        <TextBlock x:Name="LabelSignatures" x:Uid="LabelSignatures" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="SignaturesFlyout" Placement="BottomEdgeAlignedLeft">
                            <StackPanel Spacing="{ThemeResource SpaceS}" MinWidth="260">
                                <TextBlock x:Uid="SignaturesHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Signatures}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:SignatureItem">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Margin="0,2"
                                                Click="OnSignatureClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceM}">
                                                    <Border Background="White" CornerRadius="4" Padding="4">
                                                        <Image Source="{x:Bind Thumbnail}" Height="28" MaxWidth="110" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem x:Uid="RemoveSignatureItem" Click="OnRemoveSignatureClicked">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.ContextFlyout>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Click="OnAddSignatureFromImageClicked" AutomationProperties.AutomationId="AddSignatureFromImageButton" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="{ThemeResource TypeBody}" />
                                        <TextBlock x:Uid="AddFromImageLabel" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnTypeSignatureClicked" AutomationProperties.AutomationId="TypeSignatureButton" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                                        <FontIcon Glyph="&#xE70F;" FontSize="{ThemeResource TypeBody}" />
                                        <TextBlock x:Uid="TypeSignatureLabel" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnDrawSignatureClicked" AutomationProperties.AutomationId="DrawSignatureButton" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                                        <FontIcon Glyph="&#xEE56;" FontSize="{ThemeResource TypeBody}" />
                                        <TextBlock x:Uid="DrawSignatureLabel" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Click="OnWhiteoutModeClicked" x:Uid="WhiteoutButton" AutomationProperties.AutomationId="WhiteoutButton">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                        <FontIcon Glyph="&#xE75C;" FontSize="{ThemeResource TypeSubtitle}" />
                        <TextBlock x:Name="LabelWhiteout" x:Uid="LabelWhiteout" />
                    </StackPanel>
                </Button>

                <Button Click="OnTextBoxModeClicked" x:Uid="AddTextButton" AutomationProperties.AutomationId="AddTextButton">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                        <FontIcon Glyph="&#xE8D2;" FontSize="{ThemeResource TypeSubtitle}" />
                        <TextBlock x:Name="LabelAddText" x:Uid="LabelAddText" />
                    </StackPanel>
                </Button>

                <AppBarSeparator />

                <Button Click="OnFindClicked" IsEnabled="{x:Bind ViewModel.IsDocumentOpen, Mode=OneWay}" x:Uid="FindButton" AutomationProperties.AutomationId="FindButton">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                        <FontIcon Glyph="&#xE721;" FontSize="{ThemeResource TypeSubtitle}" />
                        <TextBlock x:Name="LabelFind" x:Uid="LabelFind" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{ThemeResource SpaceXs}" VerticalAlignment="Center">
                <StackPanel x:Name="ViewControls" Orientation="Horizontal" Spacing="{ThemeResource SpaceXs}" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.ZoomOutCommand}" Content="&#xE738;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="{ThemeResource TypeCaption}" x:Uid="ZoomOutButton" AutomationProperties.AutomationId="ZoomOutButton" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}"
                        VerticalAlignment="Center"
                        MinWidth="42"
                        TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Command="{x:Bind ViewModel.ZoomInCommand}" Content="&#xE710;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="{ThemeResource TypeCaption}" x:Uid="ZoomInButton" AutomationProperties.AutomationId="ZoomInButton" />
                    <Button Click="OnFitWidthClicked" Content="&#xE9A6;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="{ThemeResource TypeCaption}" x:Uid="FitWidthButton" AutomationProperties.AutomationId="FitWidthButton" />
                    <Button Click="OnFitPageClicked" Content="&#xE740;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="{ThemeResource TypeCaption}" x:Uid="FitPageButton" AutomationProperties.AutomationId="FitPageButton" />
                    <TextBlock
                        Text="{x:Bind ViewModel.PageIndicator, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Margin="8,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Narrowest state only: the whole zoom cluster behind one button, so
                     the commands on the left keep their space instead of being clipped. -->
                <!-- Reads as the live zoom level rather than an icon: a magnifier here
                     would be the second one on the bar, next to Find. -->
                <Button
                    x:Name="ViewMenuButton"
                    Visibility="Collapsed"
                    Content="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}"
                    MinWidth="58"
                    x:Uid="ViewMenuButton"
                    AutomationProperties.AutomationId="ViewMenuButton">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Uid="ZoomInItem" Command="{x:Bind ViewModel.ZoomInCommand}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="ZoomOutItem" Command="{x:Bind ViewModel.ZoomOutCommand}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE738;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="FitWidthItem" Click="OnFitWidthClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9A6;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="FitPageItem" Click="OnFitPageClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button Content="&#xE713;" FontFamily="{StaticResource SymbolThemeFontFamily}" x:Uid="SettingsButton" AutomationProperties.AutomationId="SettingsButton">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" Opening="OnSettingsOpening">
                            <StackPanel Spacing="{ThemeResource SpaceL}" MinWidth="230">
                                <StackPanel Spacing="{ThemeResource SpaceS}">
                                    <TextBlock x:Uid="CheckboxMarkHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <RadioButtons x:Name="MarkStyleChoice" SelectionChanged="OnMarkStyleChanged">
                                        <!-- TextBlocks rather than x:String items: a string cannot carry an x:Uid. -->
                                        <TextBlock x:Uid="MarkCross" />
                                        <TextBlock x:Uid="MarkCheck" />
                                        <TextBlock x:Uid="MarkFilledSquare" />
                                    </RadioButtons>
                                </StackPanel>
                                <StackPanel Spacing="{ThemeResource SpaceS}">
                                    <TextBlock x:Uid="ThemeHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <RadioButtons x:Name="ThemeChoice" SelectionChanged="OnThemeChanged">
                                        <TextBlock x:Uid="ThemeSystem" />
                                        <TextBlock x:Uid="ThemeLight" />
                                        <TextBlock x:Uid="ThemeDark" />
                                    </RadioButtons>
                                </StackPanel>
                                <!-- App language (#91). Stored as a BCP-47 tag or "" for the Windows
                                     display language; applied at startup, hence the note. -->
                                <StackPanel Spacing="{ThemeResource SpaceS}">
                                    <TextBlock x:Uid="LanguageHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <RadioButtons x:Name="LanguageChoice" SelectionChanged="OnLanguageChanged">
                                        <TextBlock x:Uid="LanguageSystem" />
                                        <TextBlock x:Uid="LanguageEnglish" />
                                        <TextBlock x:Uid="LanguageFrench" />
                                        <TextBlock x:Uid="LanguageFrenchFrance" />
                                    </RadioButtons>
                                    <TextBlock x:Uid="LanguageRestartNote" x:Name="LanguageRestartNote" Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="ReopenToggle"
                                    x:Uid="ReopenToggle"
                                    Toggled="OnReopenToggled" />
                                <ToggleSwitch
                                    x:Name="FlattenToggle"
                                    x:Uid="FlattenToggle"
                                    Toggled="OnFlattenToggled" />
                                <StackPanel x:Uid="AboutPanel" Spacing="{ThemeResource SpaceXs}" Margin="0,4,0,0" MaxWidth="260">
                                    <TextBlock x:Uid="AboutHeading" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                                    <TextBlock x:Name="AboutVersion" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Uid="AboutLicense" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock
                                        x:Uid="AboutCopyright"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock
                                        x:Uid="AboutThanks"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <HyperlinkButton
                                        NavigateUri="https://github.com/SlyWombat/MegaPDF"
                                        Content="github.com/SlyWombat/MegaPDF"
                                        ToolTipService.ToolTip="https://github.com/SlyWombat/MegaPDF"
                                        x:Uid="GitHubLink"
                                        FontSize="{ThemeResource TypeCaption}"
                                        Padding="0,2"
                                        Margin="0,2,0,0" />
                                    <HyperlinkButton
                                        x:Uid="NoticesLink"
                                        Click="OnThirdPartyNoticesClicked"
                                        FontSize="{ThemeResource TypeCaption}"
                                        Padding="0,2" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Document area: empty-state drop zone until a document is open (SDD §2.2) -->
        <Grid
            Grid.Row="1"
            AllowDrop="True"
            DragOver="OnDocumentAreaDragOver"
            Drop="OnDocumentAreaDrop">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{ThemeResource SpaceM}"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE8A5;" FontSize="{ThemeResource TypeDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Uid="EmptyStateText"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />

                <StackPanel Spacing="{ThemeResource SpaceXs}" Margin="0,20,0,0" Visibility="{x:Bind ViewModel.RecentDocumentsVisibility, Mode=OneWay}">
                    <TextBlock
                        x:Uid="RecentHeading"
                        FontSize="{ThemeResource TypeCaption}"
                        CharacterSpacing="80"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecentDocuments}" HorizontalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:RecentDocument">
                                <HyperlinkButton Click="OnRecentDocumentClicked" HorizontalAlignment="Center" ToolTipService.ToolTip="{x:Bind Path}">
                                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="{ThemeResource TypeBody}" />
                                        <TextBlock Text="{x:Bind Name}" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <ScrollViewer
                x:Name="PagesScroll"
                Visibility="{x:Bind ViewModel.DocumentVisibility, Mode=OneWay}"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                ViewChanged="OnPagesScrollViewChanged"
                PointerWheelChanged="OnPagesPointerWheel">
                <ItemsControl x:Name="PagesItems" ItemsSource="{x:Bind ViewModel.Pages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="{ThemeResource SpaceL}" Padding="24" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:PageView">
                            <local:PageCanvas
                                Width="{x:Bind Width}"
                                Height="{x:Bind Height}"
                                Background="White"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                Tapped="OnPageTapped"
                                DoubleTapped="OnPageDoubleTapped"
                                PointerPressed="OnPagePointerPressed"
                                PointerReleased="OnPagePointerReleased"
                                PointerMoved="OnPagePointerMoved"
                                PointerExited="OnPagePointerExited">
                                <Image Source="{x:Bind Source}" Stretch="Uniform" />
                                <!-- Find-match highlights (issue #26); Grid panel so Margin positions each rect. -->
                                <ItemsControl ItemsSource="{x:Bind Highlights}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:SearchHighlight">
                                            <Rectangle
                                                Width="{x:Bind Width}"
                                                Height="{x:Bind Height}"
                                                Margin="{x:Bind Margin}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Fill="{x:Bind Fill}"
                                                Stroke="{x:Bind Stroke}"
                                                StrokeThickness="{x:Bind StrokeThickness}"
                                                RadiusX="1.5"
                                                RadiusY="1.5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </local:PageCanvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- These InfoBars float over the document page, not over app chrome,
                 and InfoBar's severity backgrounds are translucent: #80F6F6F6 in
                 light, #08FFFFFF in dark. Over a white PDF page the light one
                 survives by luck and the dark one does not — 3% white over white
                 paper, with white text on it, so the message is invisible (#87).
                 An opaque background makes them chrome, which is what the find bar
                 below already does. -->
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24" Spacing="{ThemeResource SpaceS}">
                <InfoBar
                    x:Uid="FontNoticeBar"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    IsOpen="{x:Bind ViewModel.IsFontNoticeOpen, Mode=TwoWay}"
                    Severity="Informational"
                    IsClosable="True" />
                <InfoBar
                    x:Uid="ScannedHintBar"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    IsOpen="{x:Bind ViewModel.IsScannedHintOpen, Mode=TwoWay}"
                    Severity="Informational"
                    IsClosable="True" />
            </StackPanel>

            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="24,12" Spacing="{ThemeResource SpaceS}">
                <InfoBar
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    Visibility="{x:Bind ViewModel.PlacementHintVisibility, Mode=OneWay}"
                    IsOpen="True"
                    Severity="Informational"
                    Message="{x:Bind ViewModel.PlacementHint, Mode=OneWay}"
                    CloseButtonClick="OnCancelPlacementClicked" />
                <InfoBar
                    x:Uid="DefaultAppBar"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    IsOpen="{x:Bind ViewModel.IsDefaultAppCardOpen, Mode=OneWay}"
                    Severity="Informational"
                    CloseButtonClick="OnDefaultAppCardClosed">
                    <InfoBar.ActionButton>
                        <Button x:Uid="ChooseDefaultAppsButton" Click="OnChooseDefaultAppsClicked" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <!-- Ctrl+F find bar: compact Edge-style overlay (issue #26 simple search) -->
            <Border
                x:Name="FindBar"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,24,0"
                Padding="8,8"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                PreviewKeyDown="OnFindBarKeyDown">
                <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceS}">
                    <TextBox
                        x:Name="FindQuery"
                        x:Uid="FindQuery"
                        AutomationProperties.AutomationId="FindQuery"
                        MinWidth="180"
                        TextChanged="OnFindQueryChanged" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}"
                        VerticalAlignment="Center"
                        MinWidth="64"
                        TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        AutomationProperties.LiveSetting="Polite" />
                    <Button Click="OnFindPreviousClicked" IsEnabled="{x:Bind ViewModel.HasSearchResults, Mode=OneWay}" Content="&#xE70E;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="{ThemeResource TypeCaption}" x:Uid="FindPreviousButton" AutomationProperties.AutomationId="FindPreviousButton" />
                    <Button Click="OnFindNextClicked" IsEnabled="{x:Bind ViewModel.HasSearchResults, Mode=OneWay}" Content="&#xE70D;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="{ThemeResource TypeCaption}" x:Uid="FindNextButton" AutomationProperties.AutomationId="FindNextButton" />
                    <Button Click="OnFindCloseClicked" Content="&#xE711;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="{ThemeResource TypeCaption}" x:Uid="FindCloseButton" AutomationProperties.AutomationId="FindCloseButton" />
                </StackPanel>
            </Border>

            <!-- Offscreen host for rendering typed signatures (Segoe Script → bitmap). -->
            <Border x:Name="TypedSignatureHost" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                <!-- 64 is outside the type scale on purpose: this is sample ink at signature
                     size, not UI type. Foreground is the SDD §6.2 contract value, the same
                     #202020 a drawn signature and a check mark are stroked in. -->
                <TextBlock x:Name="TypedSignatureText" FontFamily="Segoe Script" FontSize="64"
                           Foreground="#FF202020" Padding="16,8" />
            </Border>
        </Grid>
    </Grid>
</Window>
