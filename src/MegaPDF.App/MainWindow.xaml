<Window
    x:Class="MegaPDF.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MegaPDF.App">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" SizeChanged="OnRootSizeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- The toolbar is one row of fixed-size buttons, so on a narrow window the
             ends used to be clipped: a 1366-wide display (the Store's own minimum)
             could not show Find or the zoom controls at all. It now sheds detail in
             two steps — labels first, then the zoom cluster folds into the View
             flyout — driven by ApplyToolbarLayout in the code-behind, which is where
             the breakpoints are documented. Every button keeps its tooltip and
             AutomationProperties.Name, so the icon-only widths stay discoverable and
             Narrator reads them exactly as before.

             Done in code rather than with VisualStates because neither mechanism works
             here: AdaptiveTrigger measures a CoreWindow, which a WinUI 3 desktop window
             does not have, and VisualStateManager.GoToState needs a Control, which this
             root Grid is not. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Single slim toolbar — the app's entire command surface (SDD §2.2) -->
        <Grid Grid.Row="0" Padding="8,4" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <Button Command="{x:Bind ViewModel.OpenCommand}" AccessKey="O" ToolTipService.ToolTip="Open a PDF (Ctrl+O)" AutomationProperties.Name="Open">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                        <TextBlock x:Name="LabelOpen" Text="Open" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </Button.KeyboardAccelerators>
                </Button>

                <!-- The visible label carries the unsaved-changes dot; the UIA name
                     stays plain "Save" so Narrator announces a stable control name. -->
                <Button Command="{x:Bind ViewModel.SaveCommand}" AccessKey="S" ToolTipService.ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="16" />
                        <TextBlock x:Name="LabelSave" Text="{x:Bind ViewModel.SaveButtonLabel, Mode=OneWay}" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                    </Button.KeyboardAccelerators>
                </Button>

                <Button Command="{x:Bind ViewModel.SaveAsCommand}" ToolTipService.ToolTip="Save a copy (Ctrl+Shift+S)" AutomationProperties.Name="Save As">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE792;" FontSize="16" />
                        <TextBlock x:Name="LabelSaveAs" Text="Save As" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                    </Button.KeyboardAccelerators>
                </Button>

                <Button Command="{x:Bind ViewModel.ShrinkForEmailCommand}" ToolTipService.ToolTip="Save a smaller copy for email" AutomationProperties.Name="Shrink for email">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE715;" FontSize="16" />
                        <TextBlock x:Name="LabelShrink" Text="Shrink" />
                    </StackPanel>
                </Button>

                <Button Click="OnPrintClicked" IsEnabled="{x:Bind ViewModel.IsDocumentOpen, Mode=OneWay}" ToolTipService.ToolTip="Print" AutomationProperties.Name="Print">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE749;" FontSize="16" />
                        <TextBlock x:Name="LabelPrint" Text="Print" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="P" />
                    </Button.KeyboardAccelerators>
                </Button>

                <AppBarSeparator />

                <Button Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                        <TextBlock x:Name="LabelUndo" Text="Undo" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z" />
                    </Button.KeyboardAccelerators>
                </Button>

                <Button Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A6;" FontSize="16" />
                        <TextBlock x:Name="LabelRedo" Text="Redo" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Y" />
                    </Button.KeyboardAccelerators>
                </Button>

                <AppBarSeparator />

                <Button ToolTipService.ToolTip="Your signatures" AutomationProperties.Name="Signatures">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEE56;" FontSize="16" />
                        <TextBlock x:Name="LabelSignatures" Text="Signatures" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="SignaturesFlyout" Placement="BottomEdgeAlignedLeft">
                            <StackPanel Spacing="8" MinWidth="260">
                                <TextBlock Text="Your signatures" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Signatures}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:SignatureItem">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Margin="0,2"
                                                Click="OnSignatureClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Background="White" CornerRadius="4" Padding="4">
                                                        <Image Source="{x:Bind Thumbnail}" Height="28" MaxWidth="110" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Remove from library" Click="OnRemoveSignatureClicked">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.ContextFlyout>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Click="OnAddSignatureFromImageClicked" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="14" />
                                        <TextBlock Text="Add from image…" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnTypeSignatureClicked" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        <TextBlock Text="Type signature…" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnDrawSignatureClicked" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEE56;" FontSize="14" />
                                        <TextBlock Text="Draw signature…" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Click="OnWhiteoutModeClicked" ToolTipService.ToolTip="Cover an area with whiteout" AutomationProperties.Name="Whiteout">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE75C;" FontSize="16" />
                        <TextBlock x:Name="LabelWhiteout" Text="Whiteout" />
                    </StackPanel>
                </Button>

                <Button Click="OnTextBoxModeClicked" ToolTipService.ToolTip="Add new text anywhere" AutomationProperties.Name="Add text">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D2;" FontSize="16" />
                        <TextBlock x:Name="LabelAddText" Text="Add text" />
                    </StackPanel>
                </Button>

                <AppBarSeparator />

                <Button Click="OnFindClicked" IsEnabled="{x:Bind ViewModel.IsDocumentOpen, Mode=OneWay}" ToolTipService.ToolTip="Find in document (Ctrl+F)" AutomationProperties.Name="Find">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                        <TextBlock x:Name="LabelFind" Text="Find" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <StackPanel x:Name="ViewControls" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.ZoomOutCommand}" Content="&#xE738;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12" ToolTipService.ToolTip="Zoom out" AutomationProperties.Name="Zoom out" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}"
                        VerticalAlignment="Center"
                        MinWidth="42"
                        TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Command="{x:Bind ViewModel.ZoomInCommand}" Content="&#xE710;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12" ToolTipService.ToolTip="Zoom in" AutomationProperties.Name="Zoom in" />
                    <Button Click="OnFitWidthClicked" Content="&#xE9A6;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12" ToolTipService.ToolTip="Fit width" AutomationProperties.Name="Fit width" />
                    <Button Click="OnFitPageClicked" Content="&#xE740;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12" ToolTipService.ToolTip="Fit page" AutomationProperties.Name="Fit page" />
                    <TextBlock
                        Text="{x:Bind ViewModel.PageIndicator, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Margin="8,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Narrowest state only: the whole zoom cluster behind one button, so
                     the commands on the left keep their space instead of being clipped. -->
                <!-- Reads as the live zoom level rather than an icon: a magnifier here
                     would be the second one on the bar, next to Find. -->
                <Button
                    x:Name="ViewMenuButton"
                    Visibility="Collapsed"
                    Content="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}"
                    MinWidth="58"
                    ToolTipService.ToolTip="Zoom and fit"
                    AutomationProperties.Name="Zoom and fit">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Zoom in" Command="{x:Bind ViewModel.ZoomInCommand}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Zoom out" Command="{x:Bind ViewModel.ZoomOutCommand}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE738;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Fit width" Click="OnFitWidthClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9A6;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Fit page" Click="OnFitPageClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button Content="&#xE713;" FontFamily="{StaticResource SymbolThemeFontFamily}" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" Opening="OnSettingsOpening">
                            <StackPanel Spacing="14" MinWidth="230">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Checkbox mark" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <RadioButtons x:Name="MarkStyleChoice" SelectionChanged="OnMarkStyleChanged">
                                        <x:String>✗  Cross</x:String>
                                        <x:String>✓  Check</x:String>
                                        <x:String>■  Filled square</x:String>
                                    </RadioButtons>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <RadioButtons x:Name="ThemeChoice" SelectionChanged="OnThemeChanged">
                                        <x:String>Use system setting</x:String>
                                        <x:String>Light</x:String>
                                        <x:String>Dark</x:String>
                                    </RadioButtons>
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="ReopenToggle"
                                    Header="Reopen last file at startup"
                                    Toggled="OnReopenToggled" />
                                <ToggleSwitch
                                    x:Name="FlattenToggle"
                                    Header="Make marks &amp; signatures permanent when saving"
                                    Toggled="OnFlattenToggled" />
                                <ToggleSwitch
                                    x:Name="UpdateCheckToggle"
                                    Header="Check for updates at startup"
                                    Toggled="OnUpdateCheckToggled" />
                                <StackPanel Spacing="2" Margin="0,4,0,0" MaxWidth="260" AutomationProperties.Name="About Mega PDF">
                                    <TextBlock Text="About Mega PDF" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                                    <TextBlock x:Name="AboutVersion" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="Free &amp; open source · Apache-2.0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock
                                        Text="Copyright © 2026 ElectricRV.ca Corporation. All rights reserved."
                                        TextWrapping="Wrap"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock
                                        Text="Special thanks to Mega Woman."
                                        TextWrapping="Wrap"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <HyperlinkButton
                                        NavigateUri="https://github.com/SlyWombat/MegaPDF"
                                        Content="github.com/SlyWombat/MegaPDF"
                                        ToolTipService.ToolTip="https://github.com/SlyWombat/MegaPDF"
                                        AutomationProperties.Name="Mega PDF on GitHub"
                                        FontSize="12"
                                        Padding="0,2"
                                        Margin="0,2,0,0" />
                                    <HyperlinkButton
                                        Click="OnThirdPartyNoticesClicked"
                                        Content="Third-party notices"
                                        AutomationProperties.Name="Third-party notices"
                                        FontSize="12"
                                        Padding="0,2" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Document area: empty-state drop zone until a document is open (SDD §2.2) -->
        <Grid
            Grid.Row="1"
            AllowDrop="True"
            DragOver="OnDocumentAreaDragOver"
            Drop="OnDocumentAreaDrop">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE8A5;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="Drag a PDF here, or click Open"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />

                <StackPanel Spacing="2" Margin="0,20,0,0" Visibility="{x:Bind ViewModel.RecentDocumentsVisibility, Mode=OneWay}">
                    <TextBlock
                        Text="RECENT"
                        FontSize="11"
                        CharacterSpacing="80"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecentDocuments}" HorizontalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:RecentDocument">
                                <HyperlinkButton Click="OnRecentDocumentClicked" HorizontalAlignment="Center" ToolTipService.ToolTip="{x:Bind Path}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="13" />
                                        <TextBlock Text="{x:Bind Name}" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <ScrollViewer
                x:Name="PagesScroll"
                Visibility="{x:Bind ViewModel.DocumentVisibility, Mode=OneWay}"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                ViewChanged="OnPagesScrollViewChanged"
                PointerWheelChanged="OnPagesPointerWheel">
                <ItemsControl x:Name="PagesItems" ItemsSource="{x:Bind ViewModel.Pages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16" Padding="24" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:PageView">
                            <local:PageCanvas
                                Width="{x:Bind Width}"
                                Height="{x:Bind Height}"
                                Background="White"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                Tapped="OnPageTapped"
                                DoubleTapped="OnPageDoubleTapped"
                                PointerPressed="OnPagePointerPressed"
                                PointerReleased="OnPagePointerReleased"
                                PointerMoved="OnPagePointerMoved"
                                PointerExited="OnPagePointerExited">
                                <Image Source="{x:Bind Source}" Stretch="Uniform" />
                                <!-- Find-match highlights (issue #26); Grid panel so Margin positions each rect. -->
                                <ItemsControl ItemsSource="{x:Bind Highlights}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:SearchHighlight">
                                            <Rectangle
                                                Width="{x:Bind Width}"
                                                Height="{x:Bind Height}"
                                                Margin="{x:Bind Margin}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Fill="{x:Bind Fill}"
                                                Stroke="{x:Bind Stroke}"
                                                StrokeThickness="{x:Bind StrokeThickness}"
                                                RadiusX="1.5"
                                                RadiusY="1.5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </local:PageCanvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24" Spacing="8">
                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsFontNoticeOpen, Mode=TwoWay}"
                    Severity="Informational"
                    Message="This document's font isn't available, so a similar one was used."
                    IsClosable="True" />
                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsScannedHintOpen, Mode=TwoWay}"
                    Severity="Informational"
                    Message="This page is a scanned image — its text is a picture and can't be edited."
                    IsClosable="True" />
            </StackPanel>

            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="24,12" Spacing="8">
                <InfoBar
                    Visibility="{x:Bind ViewModel.PlacementHintVisibility, Mode=OneWay}"
                    IsOpen="True"
                    Severity="Informational"
                    Message="{x:Bind ViewModel.PlacementHint, Mode=OneWay}"
                    CloseButtonClick="OnCancelPlacementClicked" />
                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsDefaultAppCardOpen, Mode=OneWay}"
                    Severity="Informational"
                    Message="Make MegaPDF your PDF app?"
                    CloseButtonClick="OnDefaultAppCardClosed">
                    <InfoBar.ActionButton>
                        <Button Content="Choose default apps" Click="OnChooseDefaultAppsClicked" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    x:Name="UpdateBar"
                    Severity="Success"
                    Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}"
                    IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button
                            x:Name="UpdateActionButton"
                            Content="{x:Bind ViewModel.UpdateActionLabel, Mode=OneWay}"
                            Click="OnUpdateActionClicked" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <!-- Ctrl+F find bar: compact Edge-style overlay (issue #26 simple search) -->
            <Border
                x:Name="FindBar"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,24,0"
                Padding="8,6"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                PreviewKeyDown="OnFindBarKeyDown">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox
                        x:Name="FindQuery"
                        MinWidth="180"
                        PlaceholderText="Find"
                        AutomationProperties.Name="Find in document"
                        TextChanged="OnFindQueryChanged" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}"
                        VerticalAlignment="Center"
                        MinWidth="64"
                        TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        AutomationProperties.LiveSetting="Polite" />
                    <Button Click="OnFindPreviousClicked" IsEnabled="{x:Bind ViewModel.HasSearchResults, Mode=OneWay}" Content="&#xE70E;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12" ToolTipService.ToolTip="Previous match (Shift+Enter)" AutomationProperties.Name="Previous match" />
                    <Button Click="OnFindNextClicked" IsEnabled="{x:Bind ViewModel.HasSearchResults, Mode=OneWay}" Content="&#xE70D;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12" ToolTipService.ToolTip="Next match (Enter)" AutomationProperties.Name="Next match" />
                    <Button Click="OnFindCloseClicked" Content="&#xE711;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12" ToolTipService.ToolTip="Close (Esc)" AutomationProperties.Name="Close find" />
                </StackPanel>
            </Border>

            <!-- Offscreen host for rendering typed signatures (Segoe Script → bitmap). -->
            <Border x:Name="TypedSignatureHost" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock x:Name="TypedSignatureText" FontFamily="Segoe Script" FontSize="64" Foreground="Black" Padding="16,8" />
            </Border>
        </Grid>
    </Grid>
</Window>
