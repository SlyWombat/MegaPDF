<Window
    x:Class="MegaPDF.App.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Image Source="Assets/SplashScreen.scale-200.png" Stretch="UniformToFill" />
        <!-- Credit, bottom-left, wrapped to two short lines. One long line ran
             across the artwork's own "FREE & OPEN SOURCE" (which sits centred at
             x 238-380), so both became unreadable. Keeping each line under ~200px
             leaves the artwork text clear. MaxWidth enforces that, rather than
             trusting the line break. -->
        <StackPanel
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="16,0,0,8"
            MaxWidth="200"
            IsHitTestVisible="False"
            x:Uid="SplashCredit">
            <!-- 10, below the type scale's smallest step, and 14 line height with it.
                 Raising these to TypeCaption widens both lines by about a fifth, which
                 pushes them past the MaxWidth above and back across the artwork's own
                 "FREE & OPEN SOURCE". docs/design-tokens.md §2 is a UI scale; this is
                 a credit line sitting on top of a fixed image. -->
            <TextBlock
                x:Uid="SplashCopyright"
                FontSize="10"
                LineHeight="14"
                Foreground="{ThemeResource BrandOverlayTextBrush}" />
            <TextBlock
                x:Uid="SplashThanks"
                FontSize="10"
                LineHeight="14"
                Foreground="{ThemeResource BrandOverlayTextBrush}" />
        </StackPanel>
    </Grid>
</Window>
