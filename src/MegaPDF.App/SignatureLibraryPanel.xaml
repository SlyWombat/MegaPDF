<?xml version="1.0" encoding="utf-8"?>
<!-- The signature library (SDD §3.3, #100). Each signature is a card showing the
     ink itself — the thing the user is choosing between — with its name; the card
     is the pick, an overflow (and right-click) carries Rename and Delete so nothing
     destructive sits at the same level as the pick. Draw / Type / From photo are
     three equal ways in, not a stack of text buttons.

     A UserControl rather than flyout content, so the same panel can be shown
     inside the toolbar flyout and, for the `sign` screenshot state, inside the
     window tree where RenderTargetBitmap can see it (the popup layer is invisible
     to it). -->
<UserControl
    x:Class="MegaPDF.App.SignatureLibraryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MegaPDF.App">

    <StackPanel Spacing="{ThemeResource SpaceM}" Width="332">
        <TextBlock x:Uid="SignaturesHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />

        <TextBlock
            x:Uid="NoSignaturesYet"
            Visibility="{x:Bind ViewModel.NoSignaturesVisibility, Mode=OneWay}"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ScrollViewer MaxHeight="312" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{x:Bind ViewModel.HasSignaturesVisibility, Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Signatures, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{ThemeResource SpaceS}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SignatureItem">
                        <Grid ColumnSpacing="{ThemeResource SpaceXs}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Click="OnCardClicked"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="{ThemeResource SpaceS}"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                AutomationProperties.AutomationId="SignatureCard">
                                <Grid ColumnSpacing="{ThemeResource SpaceM}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- White on purpose in both themes: the ink was captured on paper
                                         and reads as a signature only against it. -->
                                    <Border Width="136" Height="56" Background="White" CornerRadius="6" Padding="6"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Image Source="{x:Bind Thumbnail}" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </Grid>
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Uid="RenameSignatureItem" Click="OnRenameClicked">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8AC;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="DeleteSignatureItem" Click="OnDeleteClicked">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                            </Button>
                            <Button Grid.Column="1" x:Uid="SignatureOptionsButton"
                                    AutomationProperties.AutomationId="SignatureOptionsButton"
                                    VerticalAlignment="Center" Padding="8,6"
                                    Background="Transparent" BorderBrush="Transparent">
                                <FontIcon Glyph="&#xE712;" FontSize="{ThemeResource TypeBody}" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem x:Uid="RenameSignatureItem" AutomationProperties.AutomationId="RenameSignatureItem" Click="OnRenameClicked">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8AC;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="DeleteSignatureItem" AutomationProperties.AutomationId="DeleteSignatureItem" Click="OnDeleteClicked">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Three equal ways in. -->
        <Grid ColumnSpacing="{ThemeResource SpaceS}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Uid="DrawSignatureButton" Click="OnDrawClicked" AutomationProperties.AutomationId="DrawSignatureButton"
                    HorizontalAlignment="Stretch" Padding="8,10">
                <StackPanel Spacing="{ThemeResource SpaceXs}" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xEE56;" FontSize="{ThemeResource TypeSubtitle}" />
                    <TextBlock x:Uid="DrawSignatureLabel" FontSize="{ThemeResource TypeCaption}" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" x:Uid="TypeSignatureButton" Click="OnTypeClicked" AutomationProperties.AutomationId="TypeSignatureButton"
                    HorizontalAlignment="Stretch" Padding="8,10">
                <StackPanel Spacing="{ThemeResource SpaceXs}" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE70F;" FontSize="{ThemeResource TypeSubtitle}" />
                    <TextBlock x:Uid="TypeSignatureLabel" FontSize="{ThemeResource TypeCaption}" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" x:Uid="AddSignatureFromImageButton" Click="OnPhotoClicked" AutomationProperties.AutomationId="AddSignatureFromImageButton"
                    HorizontalAlignment="Stretch" Padding="8,10">
                <StackPanel Spacing="{ThemeResource SpaceXs}" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xEB9F;" FontSize="{ThemeResource TypeSubtitle}" />
                    <TextBlock x:Uid="AddFromImageLabel" FontSize="{ThemeResource TypeCaption}" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
