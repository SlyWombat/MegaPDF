<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>MegaPDF.App</RootNamespace>
    <AssemblyName>MegaPDF</AssemblyName>
    <Version>2.1.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embedded in the exe: shows in Explorer, shortcuts, and installer UI. -->
    <ApplicationIcon>Assets\megapdf.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Custom Program.cs (#348 phase 2): the generated Main starts a fresh App for every
         launch unconditionally, which is what let every Explorer double-click and "Open
         with" spawn its own process. Program.cs decides, before any window exists, whether
         this launch should redirect into an already-running instance instead.
         DisableXamlGeneratedMain is the documented property name, but this toolchain's
         App.g.i.cs only ever emits its generated Program class behind
         "#if !DISABLE_XAML_GENERATED_MAIN" — a plain C# preprocessor guard, not something
         any MSBuild target reads back out of the property — so the constant is what
         actually has to be defined; the property is kept alongside it in case a future
         SDK version wires it through directly. -->
    <DisableXamlGeneratedMain>true</DisableXamlGeneratedMain>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Unpackaged by default for development. Build the MSIX (SDD §5) with:
         dotnet build -p:Platform=x64 -p:WindowsPackageType=MSIX -p:AppxPackageSigningEnabled=false
         Package.appxmanifest declares the .pdf association and the full tile/icon set. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(WindowsPackageType)' == 'None'">true</WindowsAppSDKSelfContained>
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
    <!-- Use the Windows App SDK's self-contained MSIX/PRI build tasks instead of the
         Visual Studio-installed ones, so `dotnet build` works without VS present. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <EnablePriGenTooling>false</EnablePriGenTooling>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <!-- Unpackaged builds skip PRI generation by default, but unpackaged WinUI still
         needs resources.pri next to the exe to resolve XAML theme resources. -->
    <AppxGeneratePriEnabled>true</AppxGeneratePriEnabled>
    <!-- Strings\<lang>\Resources.resw are indexed into resources.pri by the same
         tasks (verified with makepri dump, 2026-09-10); en-US is the default
         qualifier every other language falls back to (#91). -->
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <!-- The natives MegaPDF.Core carries follow the architecture being built, not the
       machine building it (#288). Core falls back to the machine's architecture, so
       tell it only when the two differ: an ARM64 package built on an x64 machine, or
       the reverse. Passing it every time would give Core a second set of global
       properties in a solution build, and two builds of it racing on one obj folder. -->
  <PropertyGroup>
    <MegaPdfAppArch Condition="'$(Platform)' == 'ARM64' Or '$(RuntimeIdentifier)' == 'win-arm64'">arm64</MegaPdfAppArch>
    <MegaPdfAppArch Condition="'$(MegaPdfAppArch)' == '' And ('$(Platform)' == 'x64' Or '$(RuntimeIdentifier)' == 'win-x64')">x64</MegaPdfAppArch>
    <MegaPdfHostArch>x64</MegaPdfHostArch>
    <MegaPdfHostArch Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">arm64</MegaPdfHostArch>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MegaPDF.Core\MegaPDF.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(MegaPdfAppArch)' != '' And '$(MegaPdfAppArch)' != '$(MegaPdfHostArch)'">
    <ProjectReference Update="..\MegaPDF.Core\MegaPDF.Core.csproj" AdditionalProperties="MegaPdfWinArch=$(MegaPdfAppArch)" />
  </ItemGroup>

</Project>
