<!-- The MegaPDF design tokens, Windows leg. docs/design-tokens.md is the spec;
     this file is the only place in the WinUI app that names a colour.

     Fluent's own ThemeResource brushes — text, surfaces, borders, disabled
     states — stay exactly as they are. Only product chrome is brand-coloured,
     and the trade is argued in docs/design-tokens.md §1.2: the app used
     SystemAccentColor, which is whatever hue the user picked in Windows
     personalisation and can be magenta. Identity across four apps outranks
     matching the system hue on one of them.

     The one colour outside this file is #202020, the SDD §6.2 ink contract. It
     is what the user's mark is drawn in — ink on paper, inside the document —
     so it is the same in light theme, dark theme, and the saved PDF. It is not
     a token and it never inverts. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="BrandAccentColor">#0E6FD8</Color>
            <Color x:Key="BrandAccentPressedColor">#0A5BC4</Color>
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#0E6FD8" />
            <SolidColorBrush x:Key="BrandAccentPressedBrush" Color="#0A5BC4" />
            <SolidColorBrush x:Key="BrandAccentSubtleBrush" Color="#210E6FD8" />
            <SolidColorBrush x:Key="BrandAccentOnBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BrandFindMatchBrush" Color="#4D18B6C8" />
            <SolidColorBrush x:Key="BrandFindMatchCurrentBrush" Color="#730E6FD8" />
            <SolidColorBrush x:Key="BrandDangerBrush" Color="#C0362C" />
            <SolidColorBrush x:Key="BrandInkBrush" Color="#16324F" />
            <!-- Splash credit lines, over the artwork. A scrim, not a brand hue. -->
            <SolidColorBrush x:Key="BrandOverlayTextBrush" Color="#99FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BrandAccentColor">#4F9BEA</Color>
            <Color x:Key="BrandAccentPressedColor">#2D7FD4</Color>
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#4F9BEA" />
            <SolidColorBrush x:Key="BrandAccentPressedBrush" Color="#2D7FD4" />
            <SolidColorBrush x:Key="BrandAccentSubtleBrush" Color="#2E4F9BEA" />
            <SolidColorBrush x:Key="BrandAccentOnBrush" Color="#0B1B2B" />
            <SolidColorBrush x:Key="BrandFindMatchBrush" Color="#6118B6C8" />
            <SolidColorBrush x:Key="BrandFindMatchCurrentBrush" Color="#804F9BEA" />
            <SolidColorBrush x:Key="BrandDangerBrush" Color="#E2685E" />
            <SolidColorBrush x:Key="BrandInkBrush" Color="#F2F7FC" />
            <SolidColorBrush x:Key="BrandOverlayTextBrush" Color="#99FFFFFF" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Type. The Windows column of docs/design-tokens.md §2. Larger than the
         macOS column on purpose: 12pt toolbar labels are what a Windows user
         expects, and matching the Mac app here would be the wrong kind of
         consistency. -->
    <x:Double x:Key="TypeCaption">12</x:Double>
    <x:Double x:Key="TypeBody">14</x:Double>
    <x:Double x:Key="TypeSubtitle">16</x:Double>
    <x:Double x:Key="TypeTitle">28</x:Double>
    <x:Double x:Key="TypeDisplay">48</x:Double>

    <!-- Spacing, on a 4pt grid. §3. -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="SpaceXxl">32</x:Double>

</ResourceDictionary>
