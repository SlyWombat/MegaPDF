<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:MegaPDF.Avalonia"
        x:Class="MegaPDF.Avalonia.Views.PasswordWindow"
        Title="{x:Static loc:Strings.PasswordNeeded}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="24" Spacing="{DynamicResource SpaceM}">
    <TextBlock Name="PromptText" TextWrapping="Wrap" />
    <TextBox Name="PasswordBox" PasswordChar="•" Watermark="{x:Static loc:Strings.Password}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource SpaceS}">
      <Button Name="CancelButton" Content="{x:Static loc:Strings.Cancel}" />
      <Button Name="OpenButton" Content="{x:Static loc:Strings.Open}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
