<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MegaPDF.Avalonia.Views.PasswordWindow"
        Title="Password needed"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="24" Spacing="{DynamicResource SpaceM}">
    <TextBlock Name="PromptText" TextWrapping="Wrap" />
    <TextBox Name="PasswordBox" PasswordChar="•" Watermark="Password" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource SpaceS}">
      <Button Name="CancelButton" Content="Cancel" />
      <Button Name="OpenButton" Content="Open" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
