<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:MegaPDF.Avalonia"
        x:Class="MegaPDF.Avalonia.Views.RecoveryWindow"
        Title="{x:Static loc:Strings.UnsavedChanges}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="24" Spacing="{DynamicResource SpaceL}">
    <TextBlock Name="Headline" FontSize="{DynamicResource TypeSubtitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Name="Detail" TextWrapping="Wrap" Opacity="0.8" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource SpaceS}">
      <Button Name="DiscardButton" Content="{x:Static loc:Strings.DiscardThem}" />
      <Button Name="LaterButton" Content="{x:Static loc:Strings.DecideLater}" />
      <Button Name="RestoreButton" Content="{x:Static loc:Strings.Restore}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
