<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MegaPDF.Avalonia.ViewModels"
        x:Class="MegaPDF.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1000" Height="800"
        MinWidth="480" MinHeight="360">

  <DockPanel>

    <!-- Toolbar. Text labels, no icons yet: the WinUI app draws these with FontIcon
         over Segoe MDL2 glyphs, a font that does not exist on macOS. New icon
         sources are a tracked ADR-002 §7 work item; shipping empty boxes in the
         meantime would be worse than words.

         No HotKey= either: the shortcut modifier differs per platform (Cmd on
         macOS, Ctrl elsewhere), so the gestures and these tooltips are both built
         in code-behind. A Mac app with Ctrl+O is a Windows app with round corners. -->
    <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Name="OpenButton" Content="Open" />
        <Button Name="SaveButton" Content="Save" Command="{Binding SaveCommand}" />
        <Rectangle Width="1" Margin="4,2" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <!-- Sign: pick a stored signature, or draw a new one. Choosing one arms
             placement, and the next click on the page puts it there. -->
        <Button Name="SignButton" Content="Sign" IsEnabled="{Binding IsDocumentOpen}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Width="260" Spacing="8">
                <TextBlock Text="Your signatures" FontWeight="SemiBold" />
                <TextBlock Text="Nothing saved yet — draw one below."
                           TextWrapping="Wrap" Opacity="0.7"
                           IsVisible="{Binding !HasSignatures}" />
                <ListBox Name="SignatureList" ItemsSource="{Binding Signatures}"
                         MaxHeight="220" IsVisible="{Binding HasSignatures}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="2" Margin="0,4">
                        <Image Source="{Binding Thumbnail}" Height="40"
                               HorizontalAlignment="Left" Stretch="Uniform" />
                        <TextBlock Text="{Binding Name}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Name="DrawSignatureButton" Content="Draw a new signature…"
                        HorizontalAlignment="Stretch" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Rectangle Width="1" Margin="4,2" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Button Name="UndoButton" Content="Undo" Command="{Binding UndoCommand}" />
        <Button Name="RedoButton" Content="Redo" Command="{Binding RedoCommand}" />
        <Rectangle Width="1" Margin="4,2" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Button Name="ZoomOutButton" Content="Zoom out" Command="{Binding ZoomOutCommand}" />
        <Button Name="ZoomInButton" Content="Zoom in" Command="{Binding ZoomInCommand}" />
        <Button Name="ZoomResetButton" Content="Actual size" Command="{Binding ZoomResetCommand}" />
      </StackPanel>
    </Border>

    <!-- Find bar (SDD §3.6). Hidden until asked for, so it costs nothing until it
         is wanted, and Escape closes it. -->
    <Border DockPanel.Dock="Top" Padding="8,6" IsVisible="{Binding IsFindOpen}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Name="FindBox" Width="260" Watermark="Find in document" />
        <Button Name="FindPreviousButton" Content="Previous" Command="{Binding FindPreviousCommand}" />
        <Button Name="FindNextButton" Content="Next" Command="{Binding FindNextCommand}" />
        <TextBlock Text="{Binding MatchSummary}" VerticalAlignment="Center" Opacity="0.8" />
        <Button Name="CloseFindButton" Content="Done" />
      </StackPanel>
    </Border>

    <!-- Status bar. One line, plain words: SDD §2.2 wants the app to say what
         happened without a dialog. -->
    <Border DockPanel.Dock="Bottom" Padding="10,5" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
    </Border>

    <ScrollViewer Name="PageScroller"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <ItemsControl Name="PageList" ItemsSource="{Binding Pages}" Margin="0,16">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <!-- Virtualizing: only realised pages hold a raster, which is what keeps a
                 200-page document from costing 200 renders on open. -->
            <VirtualizingStackPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:PageViewModel">
            <Border Name="PageSurface"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Background="White"
                    Width="{Binding LayoutWidth}"
                    Height="{Binding LayoutHeight}"
                    BoxShadow="0 2 8 0 #22000000"
                    Cursor="Hand">
              <!-- Stretch=Fill, not Uniform: the bitmap is rasterised at exactly this
                   size, so any scaling here would mean a stale render is being smeared
                   to fit rather than re-rendered. -->
              <Panel>
                <Image Source="{Binding Image}" Stretch="Fill" IsHitTestVisible="False" />

                <!-- Search hits drawn over the page rather than into it: the raster
                     never changes, so highlighting and clearing cost no re-render. -->
                <ItemsControl ItemsSource="{Binding Highlights}" IsHitTestVisible="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Panel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:Highlight">
                      <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                 Margin="{Binding Margin}"
                                 Opacity="{Binding Opacity}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Fill="#3B82F6" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Panel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>
</Window>
