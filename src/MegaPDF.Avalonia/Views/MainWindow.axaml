<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:MegaPDF.Avalonia"
        xmlns:vm="using:MegaPDF.Avalonia.ViewModels"
        xmlns:views="using:MegaPDF.Avalonia.Views"
        x:Class="MegaPDF.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1000" Height="800"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen">

  <!-- Width and Height above are only the fallback: the window is sized to the
       screen's working area in code-behind (#143). -->

  <Window.Resources>
    <!-- Preferences that change what an edit does, kept out of the main flow
         because most people never touch them (SDD §4.4). Opened from More and from
         the menu bar (#144). -->
      <Flyout x:Key="OptionsFlyout" Placement="BottomEdgeAlignedRight">
        <StackPanel x:DataType="vm:MainViewModel" Width="260" Spacing="{DynamicResource SpaceM}">
          <TextBlock Text="{x:Static loc:Strings.TickMarksLookLike}" FontWeight="SemiBold" />
          <ComboBox HorizontalAlignment="Stretch"
                    ItemsSource="{Binding MarkStyleChoices}" SelectedItem="{Binding SelectedMarkStyle}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:MarkStyleChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox IsChecked="{Binding FlattenOnSave}"
                    Content="{x:Static loc:Strings.FlattenWhenSaving}" />
          <TextBlock Text="{x:Static loc:Strings.FlattenExplanation}"
                     TextWrapping="Wrap" FontSize="{DynamicResource TypeCaption}" Opacity="0.75" />
        </StackPanel>
      </Flyout>
  </Window.Resources>

  <DockPanel>

    <!-- Toolbar (#143, #144). One row, one fixed height, at every width.

         Groups: File (Open, Save), Tools (Sign, Add text, Cover, and the font and
         size pickers while there is text to style), history (Undo, Redo), one zoom
         control (−, the level with its menu, +), and More at the end: Save As,
         Password…, Print, Shrink and Options live there, with anything that has
         overflowed. As the window narrows the labels go first (icon only, the way
         NSToolbar's display mode does), then commands move into More, Redo and zoom
         first; Open never leaves. The thresholds are measured from the items
         themselves, in the running language: MainWindow.Toolbar.cs.

         No HotKey= here: the shortcut modifier differs per platform (Cmd on macOS,
         Ctrl elsewhere), so the gestures, these tooltips and the menu bar are built
         in code-behind (MainWindow.MenuBar.cs). -->
    <Border Name="ToolbarHost" DockPanel.Dock="Top" Height="49" Padding="8,0" BorderThickness="0,0,0,1"
            ClipToBounds="True"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Name="ToolbarItems" Orientation="Horizontal" Spacing="{DynamicResource SpaceXs}"
                  VerticalAlignment="Center">
        <!-- Every button the same height, labelled or not, so the row never changes height. -->
        <StackPanel.Styles>
          <Style Selector="StackPanel#ToolbarItems > Button, StackPanel#ToolbarItems > ToggleButton">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
          </Style>
          <Style Selector="StackPanel#ToolbarItems > ComboBox">
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
        </StackPanel.Styles>

        <Button Name="OpenButton" IsEnabled="{Binding IsIdle}">
          <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconOpen}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Classes="label" Text="{x:Static loc:Strings.Open}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="SaveButton" Command="{Binding SaveCommand}">
          <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconSave}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Classes="label" Text="{x:Static loc:Strings.Save}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <!-- Sign: pick a stored signature, or draw a new one. Choosing one arms
             placement, and the next click on the page puts it there. -->
        <Button Name="SignButton" IsEnabled="{Binding CanSign}">
          <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconSign}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Classes="label" Text="{x:Static loc:Strings.Sign}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <!-- The signature library (#100). One card per signature: the ink on a white
                 sheet — white in dark mode too, because it is paper — with its name
                 beneath and an overflow for Rename and Delete. The card is the click
                 target that arms placement; the same two actions sit on right-click. -->
            <Flyout Placement="BottomEdgeAlignedLeft">
              <!-- Paddings and margins below are the Space* token values written out
                   (4 / 8 / 12): a Thickness cannot take the x:Double resources directly. -->
              <StackPanel Width="360" Spacing="{DynamicResource SpaceM}">
                <TextBlock Text="{x:Static loc:Strings.SignaturesTitle}" FontWeight="SemiBold"
                           FontSize="{DynamicResource TypeBody}" />

                <Border IsVisible="{Binding !HasSignatures}"
                        Background="{DynamicResource BrandAccentSubtle}" CornerRadius="8"
                        Padding="12">
                  <TextBlock Text="{x:Static loc:Strings.NoSignaturesYet}" TextWrapping="Wrap"
                             FontSize="{DynamicResource TypeBody}" />
                </Border>

                <ScrollViewer MaxHeight="300" IsVisible="{Binding HasSignatures}"
                              HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl Name="SignatureList" ItemsSource="{Binding Signatures}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="{DynamicResource SpaceS}" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SignatureItem">
                        <Grid ColumnDefinitions="*,Auto">
                          <Button Classes="signature-card"
                                  Command="{Binding Owner.PlaceSignatureCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding AccessibleName}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Padding="4" CornerRadius="10"
                                  Background="Transparent" BorderThickness="0">
                            <StackPanel Spacing="{DynamicResource SpaceXs}">
                              <Border Background="White" CornerRadius="6" Height="64"
                                      BorderBrush="{DynamicResource BrandRule}" BorderThickness="1"
                                      Padding="8">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Text="{Binding Name}" FontSize="{DynamicResource TypeBody}"
                                         TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                            </StackPanel>
                            <Button.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="{x:Static loc:Strings.RenameSignature}"
                                          Command="{Binding Owner.RequestRenameSignatureCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="{x:Static loc:Strings.DeleteSignature}"
                                          Command="{Binding Owner.RequestDeleteSignatureCommand}"
                                          CommandParameter="{Binding}" />
                              </ContextMenu>
                            </Button.ContextMenu>
                          </Button>

                          <!-- Bottom-aligned so the dots sit on the name's line, not floating
                               beside the sheet. -->
                          <Button Grid.Column="1" Classes="signature-more" VerticalAlignment="Bottom"
                                  Width="28" Height="28" Padding="0" CornerRadius="14"
                                  Margin="4,4,4,0"
                                  Background="Transparent" BorderThickness="0"
                                  AutomationProperties.Name="{x:Static loc:Strings.SignatureOptions}"
                                  ToolTip.Tip="{x:Static loc:Strings.SignatureOptions}">
                            <Path Data="{StaticResource IconMore}" Width="18" Height="18"
                                  Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" />
                            <Button.Flyout>
                              <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{x:Static loc:Strings.RenameSignature}"
                                          Command="{Binding Owner.RequestRenameSignatureCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="{x:Static loc:Strings.DeleteSignature}"
                                          Command="{Binding Owner.RequestDeleteSignatureCommand}"
                                          CommandParameter="{Binding}" />
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <!-- Three equal ways in, side by side (#100, #101). The icon sits over
                     the label, and the label wraps, because in French "À partir d'une
                     photo" is far wider than a third of 360 and a Button clips its
                     content rather than trimming it (#161). Same shape as the toolbar's
                     Full step, and the same fix iOS already made for the same three
                     buttons and the same reason. -->
                <Grid ColumnDefinitions="*,*,*">
                  <Button Name="DrawSignatureButton" Grid.Column="0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          VerticalAlignment="Stretch"
                          Margin="0,0,4,0">
                    <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}">
                      <Path Data="{StaticResource IconSign}" Width="16" Height="16"
                            Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                            StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
                      <TextBlock Text="{x:Static loc:Strings.SignatureDraw}"
                             TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Name="TypeSignatureButton" Grid.Column="1"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          VerticalAlignment="Stretch"
                          Margin="4,0,4,0">
                    <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}">
                      <Path Data="{StaticResource IconText}" Width="16" Height="16"
                            Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                            StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
                      <TextBlock Text="{x:Static loc:Strings.SignatureType}"
                             TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Name="ImportSignatureButton" Grid.Column="2"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          VerticalAlignment="Stretch"
                          Margin="4,0,0,0">
                    <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}">
                      <Path Data="{StaticResource IconPhoto}" Width="16" Height="16"
                            Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                            StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
                      <TextBlock Text="{x:Static loc:Strings.SignatureFromPhoto}"
                             TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <ToggleButton Name="AddTextButton"
                      IsChecked="{Binding IsAddingText, Mode=OneWay}"
                      Command="{Binding ToggleAddTextCommand}">
          <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconText}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Classes="label" Text="{x:Static loc:Strings.AddText}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton Name="WhiteoutButton"
                      IsChecked="{Binding IsWhiteoutMode, Mode=OneWay}"
                      Command="{Binding ToggleWhiteoutCommand}"
                      ToolTip.Tip="{x:Static loc:Strings.WhiteoutCoversOnlyBody}"
                      AutomationProperties.HelpText="{x:Static loc:Strings.WhiteoutCoversOnlyBody}">
          <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconCover}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Classes="label" Text="{x:Static loc:Strings.Cover}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <!-- Redact sits beside Cover, because the pair is the point (#173): one covers,
             the other removes, and each tooltip says which. -->
        <ToggleButton Name="RedactButton"
                      IsChecked="{Binding IsRedactMode, Mode=OneWay}"
                      Command="{Binding ToggleRedactCommand}"
                      ToolTip.Tip="{x:Static loc:Strings.ToolbarRedactTip}"
                      AutomationProperties.Name="{x:Static loc:Strings.ToolbarRedact}"
                      AutomationProperties.HelpText="{x:Static loc:Strings.ToolbarRedactTip}">
          <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconRedact}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Classes="label" Text="{x:Static loc:Strings.ToolbarRedact}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <!-- Contextual (#144): on the row only while Add text is armed or an added
             text box is selected or being edited. -->
        <!-- Display names, not the raw PostScript names and enum values the
             engine speaks: "Times", not "Times-Roman"; "Croix", not "Cross". -->
        <!-- ToolbarPicker is a ComboBox that leaves an unnamed template part out of the
             accessibility tree (Views/ToolbarPicker.cs). -->
        <views:ToolbarPicker Name="FontBox" Width="120" ItemsSource="{Binding TextFontChoices}"
                  SelectedItem="{Binding SelectedTextFont}" IsEnabled="{Binding CanAddText}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:FontChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </views:ToolbarPicker>
        <views:ToolbarPicker Name="SizeBox" Width="70" ItemsSource="{Binding TextSizes}"
                  SelectedItem="{Binding TextSize}" IsEnabled="{Binding CanAddText}" />
        <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Button Name="UndoButton" Command="{Binding UndoCommand}">
          <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconUndo}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Classes="label" Text="{x:Static loc:Strings.Undo}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="RedoButton" Command="{Binding RedoCommand}">
          <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconRedo}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Classes="label" Text="{x:Static loc:Strings.Redo}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <!-- One zoom control (#144): −, the level with a menu of Actual size, the fits
             and preset levels, and +. Fixed width, so its measured width holds at any level. -->
        <Button Name="ZoomOutButton" Command="{Binding ZoomOutCommand}">
          <Path Data="{StaticResource IconZoomOut}" Width="18" Height="18"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
        </Button>
        <Button Name="ZoomMenuButton" Width="84" HorizontalContentAlignment="Center"
                IsEnabled="{Binding IsDocumentOpen}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceXs}">
            <TextBlock Text="{Binding ZoomPercentLabel}" VerticalAlignment="Center"
                       FontSize="{DynamicResource TypeBody}" />
            <Path Data="{StaticResource IconChevronDown}" Width="10" Height="10" VerticalAlignment="Center"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
          </StackPanel>
          <!-- Its menu is built and opened on click: MainWindow.Toolbar.cs, OpenToolbarMenu. -->
        </Button>
        <Button Name="ZoomInButton" Command="{Binding ZoomInCommand}">
          <Path Data="{StaticResource IconZoomIn}" Width="18" Height="18"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
        </Button>

        <!-- More (#143, #144): always here. Its menu is built as it opens — whatever
             has overflowed, then Save As, Password…, Print, Shrink and Options — and
             opened on click (MainWindow.Toolbar.cs, OpenToolbarMenu). -->
        <Button Name="MoreButton">
          <Path Data="{StaticResource IconMore}" Width="18" Height="18"
                Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Document-level work (#145): opening, saving, a password change, shrinking, print
         preparation, restoring and searching. Shown only 0.5 s into the work and kept at least
         0.3 s (BusyState), so quick work never flickers it. -->
    <Border Name="BusyStrip" DockPanel.Dock="Top" Padding="8,6,8,0" IsVisible="{Binding Busy.ShowsStrip}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            Background="{DynamicResource BrandAccentSubtle}">
      <StackPanel Spacing="{DynamicResource SpaceXs}">
        <TextBlock Name="BusyLabel" Text="{Binding Busy.Label}" FontSize="{DynamicResource TypeBody}"
                   AutomationProperties.LiveSetting="Polite" />
        <ProgressBar IsIndeterminate="True" Height="3" MinHeight="3" Margin="0,0,0,4"
                     AutomationProperties.Name="{Binding Busy.Label}" />
      </StackPanel>
    </Border>

    <!-- What the next click will do, and how to get out of it. -->
    <Border DockPanel.Dock="Top" Padding="8,8" IsVisible="{Binding IsModeActive}"
            Background="{DynamicResource BrandAccent}">
      <TextBlock Text="{Binding ModeHint}" Foreground="{DynamicResource BrandAccentOn}" />
    </Border>

    <!-- A restricted open says so and offers the owner password (#131, ADR-004 §3).
         Not dismissable: it describes the document for as long as it is open. -->
    <Border DockPanel.Dock="Top" Padding="8,8" IsVisible="{Binding IsRestricted}"
            Background="{DynamicResource BrandAccentSubtle}">
      <DockPanel>
        <Button Name="UnlockButton" DockPanel.Dock="Right" Margin="12,0,0,0" IsEnabled="{Binding IsIdle}"
                Content="{x:Static loc:Strings.UnlockEllipsis}" />
        <TextBlock Text="{x:Static loc:Strings.RestrictedBanner}" VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- Find bar (SDD §3.6). Hidden until asked for, so it costs nothing until it
         is wanted, and Escape closes it. -->
    <Border DockPanel.Dock="Top" Padding="8,8" IsVisible="{Binding IsFindOpen}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceS}">
        <TextBox Name="FindBox" Width="260" Watermark="{x:Static loc:Strings.FindInDocument}" />
        <Button Name="FindPreviousButton" Content="{x:Static loc:Strings.Previous}" Command="{Binding FindPreviousCommand}" />
        <Button Name="FindNextButton" Content="{x:Static loc:Strings.Next}" Command="{Binding FindNextCommand}" />
        <TextBlock Text="{Binding MatchSummary}" VerticalAlignment="Center" Opacity="0.8" />
        <Button Name="CloseFindButton" Content="{x:Static loc:Strings.Done}" />
      </StackPanel>
    </Border>

    <!-- Status bar. One line, plain words: SDD §2.2 wants the app to say what
         happened without a dialog. -->
    <Border DockPanel.Dock="Bottom" Padding="8,8" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding PageIndicator}"
                   VerticalAlignment="Center" Opacity="0.75" Margin="12,0,0,0" />
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Empty state (SDD §2.2): an app with nothing open should offer the two
         things you might want, not an empty grey rectangle. -->
    <Panel>
      <!-- AllowAutoHide off (#143): the auto-hiding bars stayed invisible until you
           scrolled, so a page taller than the window gave no sign there was more
           of it. The bars still only appear when the content overflows. -->
      <ScrollViewer Name="PageScroller"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False"
                  Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <ItemsControl Name="PageList" ItemsSource="{Binding Pages}" Margin="0,16">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <!-- Virtualizing: only realised pages hold a raster, which is what keeps a
                 200-page document from costing 200 renders on open. -->
            <VirtualizingStackPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:PageViewModel">
            <Border Name="PageSurface"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Background="White"
                    Width="{Binding LayoutWidth}"
                    Height="{Binding LayoutHeight}"
                    BoxShadow="{DynamicResource BrandCardShadow}">
              <!-- Stretch=Fill, not Uniform: the bitmap is rasterised at exactly this
                   size, so any scaling here would mean a stale render is being smeared
                   to fit rather than re-rendered. -->
              <Panel>
                <Image Source="{Binding Image}" Stretch="Fill" IsHitTestVisible="False" />

                <!-- A page the engine refused to rasterise says so (#93) rather than
                     staying a blank sheet the user cannot tell from "still loading". -->
                <TextBlock Text="{x:Static loc:Strings.PageRenderFailed}"
                           IsVisible="{Binding RenderFailed}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                           Foreground="{DynamicResource BrandInk}" Opacity="0.7"
                           IsHitTestVisible="False" />

                <!-- Areas marked for redaction (#173). Translucent with an outline, so
                     the user can still read what they are about to remove. Drawn over the
                     page because a mark is NOT page content: the core keeps it and never
                     writes it to the file, so there is nothing in the raster to draw. -->
                <ItemsControl ItemsSource="{Binding RedactionMarks}" IsHitTestVisible="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Panel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:RedactionMarkView">
                      <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                 Margin="{Binding Margin}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Classes.selected="{Binding IsSelected}"
                                 Fill="{DynamicResource BrandRedactionMark}"
                                 Stroke="{DynamicResource BrandRedactionMarkOutline}"
                                 StrokeThickness="1">
                        <Rectangle.Styles>
                          <Style Selector="Rectangle.selected">
                            <Setter Property="StrokeThickness" Value="2" />
                            <Setter Property="StrokeDashArray" Value="3,2" />
                          </Style>
                        </Rectangle.Styles>
                      </Rectangle>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Search hits drawn over the page rather than into it: the raster
                     never changes, so highlighting and clearing cost no re-render. -->
                <ItemsControl ItemsSource="{Binding Highlights}" IsHitTestVisible="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Panel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:Highlight">
                      <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                 Margin="{Binding Margin}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Classes.current="{Binding IsCurrent}"
                                 Fill="{DynamicResource BrandFindMatch}">
                        <!-- Hue, not opacity, separates "one of forty hits" from
                             "the hit you are on". Two brand colours read apart at
                             a glance on a white page and on a dark scan alike;
                             two strengths of one colour do not. -->
                        <Rectangle.Styles>
                          <Style Selector="Rectangle.current">
                            <Setter Property="Fill" Value="{DynamicResource BrandFindMatchCurrent}" />
                          </Style>
                        </Rectangle.Styles>
                      </Rectangle>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Page-level work (#145): the #139 check before a change, and the change. -->
                <Border Name="PageBusyBadge" IsVisible="{Binding ShowsBusyOnPage}" IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                        Padding="12,8" CornerRadius="8"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BoxShadow="{DynamicResource BrandCardShadow}">
                  <StackPanel Spacing="{DynamicResource SpaceXs}">
                    <TextBlock Text="{Binding BusyLabel}" FontSize="{DynamicResource TypeCaption}"
                               HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="160" Height="3" MinHeight="3"
                                 AutomationProperties.Name="{Binding BusyLabel}" />
                  </StackPanel>
                </Border>
                <!-- The text-edit check runs under the line it is about. -->
                <ProgressBar IsVisible="{Binding ShowsBusyOnLine}" IsHitTestVisible="False" IsIndeterminate="True"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="{Binding BusyMargin}" Width="{Binding BusyWidth}" Height="3" MinHeight="3"
                             AutomationProperties.Name="{Binding BusyLabel}" />
              </Panel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

      <Border IsVisible="{Binding ShowEmptyState}"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="{DynamicResource SpaceL}" MaxWidth="420">
          <TextBlock Text="MegaPDF" FontSize="{DynamicResource TypeTitle}" FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{x:Static loc:Strings.EmptyStateTagline}"
                     Opacity="0.75" HorizontalAlignment="Center" TextWrapping="Wrap" />
          <Button Name="EmptyOpenButton" Content="{x:Static loc:Strings.OpenAPdfEllipsis}"
                  HorizontalAlignment="Center" />

          <TextBlock Text="{x:Static loc:Strings.Recent}" FontWeight="SemiBold" Margin="0,16,0,0"
                     IsVisible="{Binding HasRecents}" />
          <ListBox Name="RecentList" ItemsSource="{Binding Recents}"
                   IsVisible="{Binding HasRecents}" MaxHeight="200"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <!-- Every row says where its file lives, the way Finder's path bar
                     writes it (#165): display names joined with "›", never a POSIX
                     path. The help tag is the location in full, for a line the row
                     had to shorten. -->
                <StackPanel ToolTip.Tip="{Binding Tip}"
                            AutomationProperties.Name="{Binding AccessibleName}">
                  <StackPanel.ContextFlyout>
                    <MenuFlyout>
                      <MenuItem Header="{x:Static loc:Strings.ShowInFinder}"
                                Click="OnShowRecentInFinder" />
                    </MenuFlyout>
                  </StackPanel.ContextFlyout>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Location}" IsVisible="{Binding HasLocation}"
                             TextTrimming="CharacterEllipsis"
                             FontSize="{DynamicResource TypeCaption}" Opacity="0.75" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
    </Panel>

  </DockPanel>
</Window>
