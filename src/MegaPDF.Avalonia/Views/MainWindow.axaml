<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:MegaPDF.Avalonia"
        xmlns:vm="using:MegaPDF.Avalonia.ViewModels"
        x:Class="MegaPDF.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1000" Height="800"
        MinWidth="480" MinHeight="360">

  <DockPanel>

    <!-- Toolbar. Text labels, no icons yet: the WinUI app draws these with FontIcon
         over Segoe MDL2 glyphs, a font that does not exist on macOS. New icon
         sources are a tracked ADR-002 §7 work item; shipping empty boxes in the
         meantime would be worse than words.

         No HotKey= either: the shortcut modifier differs per platform (Cmd on
         macOS, Ctrl elsewhere), so the gestures and these tooltips are both built
         in code-behind. A Mac app with Ctrl+O is a Windows app with round corners. -->
    <Border DockPanel.Dock="Top" Padding="8,8" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceS}">
        <Button Name="OpenButton" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconOpen}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.Open}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="SaveButton" Command="{Binding SaveCommand}" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconSave}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.Save}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="SaveAsButton" IsEnabled="{Binding IsDocumentOpen}" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconSaveAs}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.SaveAs}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="PrintButton" Command="{Binding PrintCommand}" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconPrint}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.Print}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="ShrinkButton" IsEnabled="{Binding CanShrink}"
                ToolTip.Tip="{x:Static loc:Strings.SaveSmallerCopyForEmail}" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconShrink}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.Shrink}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Rectangle Width="1" Margin="4,2" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <!-- Sign: pick a stored signature, or draw a new one. Choosing one arms
             placement, and the next click on the page puts it there. -->
        <Button Name="SignButton" IsEnabled="{Binding IsDocumentOpen}">
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconSign}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.Sign}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Width="260" Spacing="{DynamicResource SpaceS}">
                <TextBlock Text="{x:Static loc:Strings.YourSignatures}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.NoSignaturesYet}"
                           TextWrapping="Wrap" Opacity="0.7"
                           IsVisible="{Binding !HasSignatures}" />
                <ListBox Name="SignatureList" ItemsSource="{Binding Signatures}"
                         MaxHeight="220" IsVisible="{Binding HasSignatures}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <!-- 2, not SpaceXs: the thumbnail and its name are one item in the
                           list, and 4 starts to read as two. docs/design-tokens.md §3
                           allows an off-grid value that carries its reason. -->
                      <StackPanel Spacing="2" Margin="0,4">
                        <Image Source="{Binding Thumbnail}" Height="40"
                               HorizontalAlignment="Left" Stretch="Uniform" />
                        <TextBlock Text="{Binding Name}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Name="DrawSignatureButton" Content="{x:Static loc:Strings.DrawNewSignature}"
                        HorizontalAlignment="Stretch" />
                <Button Name="ImportSignatureButton" Content="{x:Static loc:Strings.UsePhotoOfSignature}"
                        HorizontalAlignment="Stretch" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <ToggleButton Name="AddTextButton"
                      IsChecked="{Binding IsAddingText, Mode=OneWay}"
                      Command="{Binding ToggleAddTextCommand}" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconText}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.AddText}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <!-- Display names, not the raw PostScript names and enum values the
             engine speaks: "Times", not "Times-Roman"; "Croix", not "Cross". -->
        <ComboBox Name="FontBox" Width="120" ItemsSource="{Binding TextFontChoices}"
                  SelectedItem="{Binding SelectedTextFont}" IsEnabled="{Binding IsDocumentOpen}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:FontChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Name="SizeBox" Width="70" ItemsSource="{Binding TextSizes}"
                  SelectedItem="{Binding TextSize}" IsEnabled="{Binding IsDocumentOpen}" />
        <ToggleButton Name="WhiteoutButton"
                      IsChecked="{Binding IsWhiteoutMode, Mode=OneWay}"
                      Command="{Binding ToggleWhiteoutCommand}" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconCover}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.Cover}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </ToggleButton>

        <Rectangle Width="1" Margin="4,2" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Button Name="UndoButton" Command="{Binding UndoCommand}" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconUndo}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.Undo}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="RedoButton" Command="{Binding RedoCommand}" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconRedo}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.Redo}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Rectangle Width="1" Margin="4,2" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Button Name="ZoomOutButton" Command="{Binding ZoomOutCommand}" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconZoomOut}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.ZoomOut}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="ZoomInButton" Command="{Binding ZoomInCommand}" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconZoomIn}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.ZoomIn}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="ZoomResetButton" Command="{Binding ZoomResetCommand}" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconActualSize}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.ActualSize}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="FitWidthButton" Command="{Binding FitWidthCommand}" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconFitWidth}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.FitWidth}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="FitPageButton" Command="{Binding FitPageCommand}" >
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconFitPage}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.FitPage}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>

        <Rectangle Width="1" Margin="4,2" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <!-- Preferences that change what an edit does, kept out of the main flow
             because most people never touch them (SDD §4.4). -->
        <Button Name="SettingsButton">
          <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpaceXs}" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconOptions}" Width="18" Height="18"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
            <TextBlock Text="{x:Static loc:Strings.Options}" FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
          </StackPanel>
        
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Width="260" Spacing="{DynamicResource SpaceM}">
                <TextBlock Text="{x:Static loc:Strings.TickMarksLookLike}" FontWeight="SemiBold" />
                <ComboBox Name="MarkStyleBox" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding MarkStyleChoices}" SelectedItem="{Binding SelectedMarkStyle}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:MarkStyleChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Name="FlattenBox" IsChecked="{Binding FlattenOnSave}"
                          Content="{x:Static loc:Strings.FlattenWhenSaving}" />
                <TextBlock Text="{x:Static loc:Strings.FlattenExplanation}"
                           TextWrapping="Wrap" FontSize="{DynamicResource TypeCaption}" Opacity="0.75" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Border>

    <!-- What the next click will do, and how to get out of it. -->
    <Border DockPanel.Dock="Top" Padding="8,8" IsVisible="{Binding IsModeActive}"
            Background="{DynamicResource BrandAccent}">
      <TextBlock Text="{Binding ModeHint}" Foreground="{DynamicResource BrandAccentOn}" />
    </Border>

    <!-- Find bar (SDD §3.6). Hidden until asked for, so it costs nothing until it
         is wanted, and Escape closes it. -->
    <Border DockPanel.Dock="Top" Padding="8,8" IsVisible="{Binding IsFindOpen}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceS}">
        <TextBox Name="FindBox" Width="260" Watermark="{x:Static loc:Strings.FindInDocument}" />
        <Button Name="FindPreviousButton" Content="{x:Static loc:Strings.Previous}" Command="{Binding FindPreviousCommand}" />
        <Button Name="FindNextButton" Content="{x:Static loc:Strings.Next}" Command="{Binding FindNextCommand}" />
        <TextBlock Text="{Binding MatchSummary}" VerticalAlignment="Center" Opacity="0.8" />
        <Button Name="CloseFindButton" Content="{x:Static loc:Strings.Done}" />
      </StackPanel>
    </Border>

    <!-- Status bar. One line, plain words: SDD §2.2 wants the app to say what
         happened without a dialog. -->
    <Border DockPanel.Dock="Bottom" Padding="8,8" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding PageIndicator}"
                   VerticalAlignment="Center" Opacity="0.75" Margin="12,0,0,0" />
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Empty state (SDD §2.2): an app with nothing open should offer the two
         things you might want, not an empty grey rectangle. -->
    <Panel>
      <ScrollViewer Name="PageScroller"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <ItemsControl Name="PageList" ItemsSource="{Binding Pages}" Margin="0,16">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <!-- Virtualizing: only realised pages hold a raster, which is what keeps a
                 200-page document from costing 200 renders on open. -->
            <VirtualizingStackPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:PageViewModel">
            <Border Name="PageSurface"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Background="White"
                    Width="{Binding LayoutWidth}"
                    Height="{Binding LayoutHeight}"
                    BoxShadow="{DynamicResource BrandCardShadow}">
              <!-- Stretch=Fill, not Uniform: the bitmap is rasterised at exactly this
                   size, so any scaling here would mean a stale render is being smeared
                   to fit rather than re-rendered. -->
              <Panel>
                <Image Source="{Binding Image}" Stretch="Fill" IsHitTestVisible="False" />

                <!-- Search hits drawn over the page rather than into it: the raster
                     never changes, so highlighting and clearing cost no re-render. -->
                <ItemsControl ItemsSource="{Binding Highlights}" IsHitTestVisible="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Panel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:Highlight">
                      <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                 Margin="{Binding Margin}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Classes.current="{Binding IsCurrent}"
                                 Fill="{DynamicResource BrandFindMatch}">
                        <!-- Hue, not opacity, separates "one of forty hits" from
                             "the hit you are on". Two brand colours read apart at
                             a glance on a white page and on a dark scan alike;
                             two strengths of one colour do not. -->
                        <Rectangle.Styles>
                          <Style Selector="Rectangle.current">
                            <Setter Property="Fill" Value="{DynamicResource BrandFindMatchCurrent}" />
                          </Style>
                        </Rectangle.Styles>
                      </Rectangle>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Panel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

      <Border IsVisible="{Binding ShowEmptyState}"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="{DynamicResource SpaceL}" MaxWidth="420">
          <TextBlock Text="MegaPDF" FontSize="{DynamicResource TypeTitle}" FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{x:Static loc:Strings.EmptyStateTagline}"
                     Opacity="0.75" HorizontalAlignment="Center" TextWrapping="Wrap" />
          <Button Name="EmptyOpenButton" Content="{x:Static loc:Strings.OpenAPdfEllipsis}"
                  HorizontalAlignment="Center" />

          <TextBlock Text="{x:Static loc:Strings.Recent}" FontWeight="SemiBold" Margin="0,16,0,0"
                     IsVisible="{Binding HasRecents}" />
          <ListBox Name="RecentList" ItemsSource="{Binding Recents}"
                   IsVisible="{Binding HasRecents}" MaxHeight="200"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
    </Panel>

  </DockPanel>
</Window>
