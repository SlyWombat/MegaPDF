<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:MegaPDF.Avalonia"
             x:Class="MegaPDF.Avalonia.App"
             Name="MegaPDF"
             RequestedThemeVariant="Default">
  <!-- Default, not Light/Dark: the app follows the OS, which on macOS is what
       people expect and on Windows matches the WinUI app's behaviour. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MegaPDF/Brand.axaml" />
        <ResourceInclude Source="avares://MegaPDF/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Accessibility (#144). Parts of Fluent's templates that VoiceOver otherwise found
         as unnamed or type-named elements:

         - A scroll bar's arrow and page buttons. The arrows' only content is a PathIcon,
           so they were announced as "Avalonia.Controls.PathIcon"; the page buttons had
           no name at all. Hiding them (AccessibilityView Raw) works for UI Automation
           but not on the Mac, whose accessibility tree lists every child regardless, so
           they are named for what they do.

         The unnamed "unknown" element beside each toolbar picker is handled where the
         pickers are: Views/ToolbarPicker.cs. -->
    <Style Selector="ScrollBar:vertical /template/ RepeatButton#PART_LineUpButton">
      <Setter Property="AutomationProperties.Name" Value="{x:Static loc:Strings.ScrollBarLineUp}" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ RepeatButton#PART_LineDownButton">
      <Setter Property="AutomationProperties.Name" Value="{x:Static loc:Strings.ScrollBarLineDown}" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ RepeatButton#PART_PageUpButton">
      <Setter Property="AutomationProperties.Name" Value="{x:Static loc:Strings.ScrollBarPageUp}" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ RepeatButton#PART_PageDownButton">
      <Setter Property="AutomationProperties.Name" Value="{x:Static loc:Strings.ScrollBarPageDown}" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ RepeatButton#PART_LineUpButton">
      <Setter Property="AutomationProperties.Name" Value="{x:Static loc:Strings.ScrollBarLineLeft}" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ RepeatButton#PART_LineDownButton">
      <Setter Property="AutomationProperties.Name" Value="{x:Static loc:Strings.ScrollBarLineRight}" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ RepeatButton#PART_PageUpButton">
      <Setter Property="AutomationProperties.Name" Value="{x:Static loc:Strings.ScrollBarPageLeft}" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ RepeatButton#PART_PageDownButton">
      <Setter Property="AutomationProperties.Name" Value="{x:Static loc:Strings.ScrollBarPageRight}" />
    </Style>
  </Application.Styles>
</Application>
