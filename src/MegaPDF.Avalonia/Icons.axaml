<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Toolbar icons as inline geometry.

    Not an icon font: the WinUI app draws these with Segoe MDL2, which does not
    exist on macOS, and bundling a font to solve that would add a licence and a
    download for sixteen glyphs. Geometry has no such dependency and scales
    cleanly on retina displays.

    All drawn on a 24×24 grid, stroked rather than filled, so one style keeps them
    consistent and they inherit the theme's foreground colour.
  -->

  <StreamGeometry x:Key="IconOpen">M3,7 L9,7 L11,9 L21,9 L21,19 L3,19 Z M3,7 L3,19</StreamGeometry>
  <StreamGeometry x:Key="IconSave">M12,4 L12,15 M8,11 L12,15 L16,11 M4,20 L20,20</StreamGeometry>
  <StreamGeometry x:Key="IconSaveAs">M12,3 L12,13 M8,9 L12,13 L16,9 M4,20 L14,20 M18,17 L18,23 M15,20 L21,20</StreamGeometry>
  <StreamGeometry x:Key="IconPrint">M7,9 L7,4 L17,4 L17,9 M5,9 L19,9 L19,16 L17,16 M7,16 L5,16 M7,14 L17,14 L17,21 L7,21 Z</StreamGeometry>
  <StreamGeometry x:Key="IconShrink">M10,4 L10,10 L4,10 M14,20 L14,14 L20,14 M10,10 L4,4 M14,14 L20,20</StreamGeometry>
  <StreamGeometry x:Key="IconSign">M4,20 L4,17 L15,6 L18,9 L7,20 Z M14,7 L17,10</StreamGeometry>
  <StreamGeometry x:Key="IconText">M5,6 L15,6 M10,6 L10,18 M17,13 L17,21 M13,17 L21,17</StreamGeometry>
  <StreamGeometry x:Key="IconCover">M4,8 L20,8 L20,16 L4,16 Z</StreamGeometry>
  <StreamGeometry x:Key="IconUndo">M8,7 L4,11 L8,15 M4,11 L14,11 A5,5 0 0 1 14,21 L11,21</StreamGeometry>
  <StreamGeometry x:Key="IconRedo">M16,7 L20,11 L16,15 M20,11 L10,11 A5,5 0 0 0 10,21 L13,21</StreamGeometry>
  <StreamGeometry x:Key="IconZoomIn">M11,4 A7,7 0 1 1 11,18 A7,7 0 1 1 11,4 M16,16 L21,21 M8,11 L14,11 M11,8 L11,14</StreamGeometry>
  <StreamGeometry x:Key="IconZoomOut">M11,4 A7,7 0 1 1 11,18 A7,7 0 1 1 11,4 M16,16 L21,21 M8,11 L14,11</StreamGeometry>
  <StreamGeometry x:Key="IconActualSize">M4,4 L20,4 L20,20 L4,20 Z M9,9 L15,9 L15,15 L9,15 Z</StreamGeometry>
  <StreamGeometry x:Key="IconFitWidth">M3,12 L21,12 M3,8 L3,16 M21,8 L21,16 M7,9 L4,12 L7,15 M17,9 L20,12 L17,15</StreamGeometry>
  <StreamGeometry x:Key="IconFitPage">M12,3 L12,21 M8,3 L16,3 M8,21 L16,21 M9,7 L12,4 L15,7 M9,17 L12,20 L15,17</StreamGeometry>
  <StreamGeometry x:Key="IconOptions">M4,7 L20,7 M4,12 L20,12 M4,17 L20,17 M9,7 A2,2 0 1 1 9,7.01 M15,12 A2,2 0 1 1 15,12.01 M8,17 A2,2 0 1 1 8,17.01</StreamGeometry>
  <StreamGeometry x:Key="IconFind">M10,3 A7,7 0 1 1 10,17 A7,7 0 1 1 10,3 M15,15 L21,21</StreamGeometry>

  <!--
    Icon above label, which is how the Windows toolbar reads. The label stays:
    these are unfamiliar glyphs on a first run, and a toolbar you have to decode
    is worse than one that spells itself out.
  -->
  <ControlTheme x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="8,8" />
    <Setter Property="MinWidth" Value="58" />
  </ControlTheme>
</ResourceDictionary>
