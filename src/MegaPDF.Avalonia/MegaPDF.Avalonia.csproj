<Project Sdk="Microsoft.NET.Sdk">

  <!-- ADR-002 Option B: the cross-platform UI over MegaPDF.Core. Named for the
       technology, not a platform — it runs on Windows too, which is the whole
       point of the no-Mac constraint (ADR-002 criterion 3): the UI is developed
       and run on Windows, and macOS is a bundle-and-notarize step.

       Deliberately NOT in MegaPDF.sln yet. ci.yml runs `dotnet build
       MegaPDF.sln` on windows-latest and an in-progress port should not be able
       to break product CI. Add it to the solution once it builds green. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MegaPDF.Avalonia</RootNamespace>
    <AssemblyName>MegaPDF</AssemblyName>
    <!-- Its own version line, not the Windows app's 1.6.2: this is a new app with
         a viewer's worth of features so far, and claiming 1.6.2 would promise
         parity it does not have yet. -->
    <Version>1.7.0</Version>
    <RuntimeIdentifiers>osx-arm64;osx-x64;win-x64;linux-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- The About window's icon and the third-party notices (#176). Embedded in the
         assembly, which is what survives a PublishSingleFile bundle: nothing loose
         lands in Contents/MacOS for codesign to trip over. tools/build-macos-app.sh
         also copies the notices into Contents/Resources — that copy is the one the
         licences require to travel with the binary, and the one the app reads, so
         what the window shows is what shipped. THIRD-PARTY-NOTICES.txt is generated
         by tools/gen_third_party_notices.py and AppIcon.png by tools/gen_about_icon.py;
         both are committed. -->
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.*" />
    <!-- For the self-test only (#144): the toolbar menus are opened in a real window on
         the headless platform, because a menu that pops up empty is invisible to every
         check that drives the view model alone. Nothing else starts this platform. -->
    <PackageReference Include="Avalonia.Headless" Version="11.2.*" />
    <!-- Same MVVM library the WinUI app uses, so MainViewModel's [ObservableProperty]
         and [RelayCommand] attributes mean the same thing on both sides when the
         extraction in ADR-002 happens. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- Pinned to the exact version Avalonia.Skia resolves. A floating reference
         that drifts ahead gives two SkiaSharp versions wanting different
         libSkiaSharp ABIs in one bundle, and that fails at runtime on macOS rather
         than at build. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine, unmodified — 120 tests green on macOS (ADR-002 spike).
         Note Core's unconditional win-x64 pdfium.dll copy item: correct on
         Windows, and the OS condition it needs for macOS is tracked in ADR-002
         fact 2. Not changed here — this project is additive until the port
         proper begins. -->
    <ProjectReference Include="..\MegaPDF.Core\MegaPDF.Core.csproj" />
  </ItemGroup>

</Project>
