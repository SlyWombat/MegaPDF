# Build results
[Bb]in/
[Oo]bj/
[Oo]ut/
artifacts/

# Visual Studio / Rider / VS Code
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Test results & coverage
TestResults/
*.trx
coverage*.json
coverage*.xml
coverage*.info

# NuGet
*.nupkg
*.snupkg
packages/

# MSIX packaging output
AppPackages/
BundleArtifacts/
*.appx
*.msix
*.appxbundle
*.msixbundle
*.cer
*.pfx

# Private local documents — never committed
tests/Private/

# Logs and OS cruft
*.log
Thumbs.db
Desktop.ini

# Local distribution drops (CI artifacts downloaded for sideloading)
dist/

# Local secrets and Python cruft — never committed
.env
__pycache__/

# Understand-Anything knowledge graph: generated analysis output (~600 KB), rebuilt
# by /understand. The .understandignore inside it IS worth keeping if you want the
# exclusions shared, but the graph itself is a build artifact.
.ua/

# PDFium for macOS is fetched by tools/fetch-pdfium-mac.sh, not committed
# (ADR-002 §7 tracks vendor-vs-fetch for the shipping app).
libs/pdfium/mac-univ/
spike/Vendor/

# Local fixture output from tools/gen_test_fixtures.py
.fixtures/
