    "Anything under a whiteout is still in the file, and another app can copy or search it. To take it out of the file, use Redact." : {
      "comment" : "First-use hint body (#173)",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui est sous un correcteur reste dans le fichier, et une autre application peut le copier ou le retrouver par une recherche. Pour le retirer du fichier, utilisez Caviarder."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
