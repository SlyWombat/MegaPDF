      }
    },
    "This form is built to be filled in with Adobe Reader. You can still view, print, save and share it here — only filling it in isn't possible." : {
      "comment" : "#456, #457: the calm, persistent dynamic-XFA banner shown for the life of an open whose megapdf_document_flags() reports MEGAPDF_DOC_DYNAMIC_XFA",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce formulaire est conçu pour être rempli dans Adobe Reader. Vous pouvez tout de même l'afficher, l'imprimer, l'enregistrer et le partager ici — seul le remplir n'est pas possible."
          }
