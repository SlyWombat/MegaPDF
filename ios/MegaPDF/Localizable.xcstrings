    "A redaction on this document didn't finish, so it can only be closed now. Close it and open it again — nothing was written." : {
      "comment" : "ES-REVIEW #724 — new, not yet read by the reviewer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una censura en este documento no se completó, por lo que ahora solo se puede cerrar. Ciérralo y ábrelo de nuevo; no se escribió nada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una censura en este documento no se completó, por lo que ahora solo se puede cerrar. Ciérralo y ábrelo de nuevo; no se escribió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un caviardage de ce document ne s'est pas terminé, alors il ne peut plus qu'être fermé. Fermez-le et ouvrez-le de nouveau — rien n'a été écrit."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un caviardage de ce document ne s'est pas terminé, alors il ne peut plus qu'être fermé. Fermez-le et ouvrez-le de nouveau — rien n'a été écrit."
