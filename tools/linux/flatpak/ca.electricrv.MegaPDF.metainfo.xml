<!-- AppStream metadata for MegaPDF (#158). This is what a software centre shows and
     what Flathub's listing is built from; the desktop file alone is not enough for
     either. Validated by tools/linux/build-flatpak.sh with `appstreamcli validate`.

     Not submitted anywhere. tools/Linux-Packaging.md lists what is still Dave's to
     decide here — the app ID, the screenshots and the release history. -->
<component type="desktop-application">
  <id>ca.electricrv.MegaPDF</id>

  <!-- The licence of this file, which is not the licence of the app. CC0 is what
       Flathub asks for so listing text can be reused; the app is Apache-2.0. -->
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>

  <name>MegaPDF</name>
  <name xml:lang="fr">MegaPDF</name>
  <summary>Fill, check and sign PDFs</summary>
  <summary xml:lang="fr">Remplir, cocher et signer des PDF</summary>
  <summary xml:lang="fr-CA">Remplir, cocher et signer des PDF</summary>

  <developer id="ca.electricrv">
    <name>Electric RV</name>
  </developer>

  <launchable type="desktop-id">ca.electricrv.MegaPDF.desktop</launchable>

  <description>
    <p>
      MegaPDF does the one job most people actually have with a PDF: someone sent you a
      form, and you need to send it back filled in, checked off, and signed. No account,
      no subscription, no cloud. Everything happens on your own computer.
    </p>
    <p>What it does:</p>
    <ul>
      <li>Check any box — real form fields and plain printed squares alike, including
      drawn checkboxes other apps treat as decoration.</li>
      <li>Type on any line, in the size and face that matches the form. What you add is
      real, searchable text, not a sticker on top of the page.</li>
      <li>Fix the document's own text. MegaPDF keeps the document's font where it can
      and says so when it had to use a similar one; if a change would disturb the rest
      of the page it tells you instead of quietly moving things.</li>
      <li>Sign by drawing, or from a photograph of a signature on paper — the white
      background disappears. Signatures stay in a private library on your computer.</li>
      <li>Save without fear. Every document is verified before your original is touched,
      so a failed save cannot corrupt the file someone sent you.</li>
      <li>Search the whole document as you type, with every match counted.</li>
    </ul>
    <p>
      MegaPDF makes no network connection and this package asks for no network
      permission. Your documents and your signature never leave your computer, because
      there is no server for them to go to. The app is open source, so anyone can check.
    </p>
  </description>

  <url type="homepage">https://electricrv.ca/megapdf/</url>
  <url type="bugtracker">https://github.com/SlyWombat/MegaPDF/issues</url>
  <url type="vcs-browser">https://github.com/SlyWombat/MegaPDF</url>

