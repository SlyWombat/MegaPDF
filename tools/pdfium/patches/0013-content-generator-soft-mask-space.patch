+RetainPtr<CPDF_Dictionary> CPDF_PageContentGenerator::GetSoftMaskCopy(
+    RetainPtr<const CPDF_Dictionary> ext_gstate,
+    const CFX_Matrix& matrix) {
+  const auto key = std::make_pair(
+      static_cast<const CPDF_Object*>(ext_gstate.Get()),
+      std::array<float, 6>{matrix.a, matrix.b, matrix.c, matrix.d, matrix.e,
+                           matrix.f});
+  CPDF_PageObjectHolder::SoftMaskCopyMap& copies =
+      obj_holder_->soft_mask_copies();
+  auto it = copies.find(key);
+  if (it != copies.end() &&
+      document_->GetIndirectObject(it->second.copy->GetObjNum()) ==
+          it->second.copy) {
+    return it->second.copy;
+  }
+  RetainPtr<const CPDF_Dictionary> soft_mask = ext_gstate->GetDictFor("SMask");
+  RetainPtr<const CPDF_Stream> group =
+      soft_mask ? soft_mask->GetStreamFor("G") : nullptr;
+  if (!group) {
+    return nullptr;
+  }
+  // The group is drawn through its own /Matrix and then the mask's matrix, so the
+  // product in /Matrix draws it the same from the identity.
+  RetainPtr<CPDF_Stream> group_copy = ToStream(group->Clone());
+  RetainPtr<CPDF_Dictionary> mask_copy = ToDictionary(soft_mask->Clone());
+  RetainPtr<CPDF_Dictionary> ext_gstate_copy = ToDictionary(ext_gstate->Clone());
+  if (!group_copy || !mask_copy || !ext_gstate_copy) {
+    return nullptr;
+  }
+  group_copy->GetMutableDict()->SetMatrixFor(
+      "Matrix", group->GetDict()->GetMatrixFor("Matrix") * matrix);
+  document_->AddIndirectObject(group_copy);
+  mask_copy->SetNewFor<CPDF_Reference>("G", document_, group_copy->GetObjNum());
+  ext_gstate_copy->SetFor("SMask", mask_copy);
+  document_->AddIndirectObject(ext_gstate_copy);
+  copies[key] = {ext_gstate, ext_gstate_copy};
+  return ext_gstate_copy;
+}
+
+void CPDF_PageContentGenerator::WriteClipPath(fxcrt::ostringstream* buf,
+                                              CPDF_PageObject* pPageObj) {
+  const CPDF_ClipPath& clip_path = pPageObj->clip_path();
+  if (!clip_path.HasRef()) {
+    return;
+  }
+  for (size_t i = 0; i < clip_path.GetPathCount(); ++i) {
+    CPDF_Path path = clip_path.GetPath(i);
+    ProcessPathPoints(buf, &path);
+    switch (clip_path.GetClipType(i)) {
+      case CFX_FillRenderOptions::FillType::kWinding:
+        *buf << " W ";
+        break;
+      case CFX_FillRenderOptions::FillType::kEvenOdd:
+        *buf << " W* ";
+        break;
+      case CFX_FillRenderOptions::FillType::kNoFill:
+        NOTREACHED();
+    }
+
+    // Use a no-op path-painting operator to terminate the path without
+    // causing any marks to be placed on the page.
+    *buf << "n ";
+  }
+}
