+// Whether two ExtGState values are the same number, name or boolean.
+bool SameSimpleValue(const CPDF_Object* a, const CPDF_Object* b) {
+  if (!a || !b || a->GetType() != b->GetType()) {
+    return false;
+  }
+  if (a->IsNumber()) {
+    return a->GetNumber() == b->GetNumber();
+  }
+  if (a->IsName()) {
+    return a->GetString() == b->GetString();
+  }
+  if (a->IsBoolean()) {
+    return a->GetInteger() == b->GetInteger();
+  }
+  return false;
+}
+
+// Whether `candidate` sets exactly the entries `wanted` does, each a number, name or
+// boolean of the same value. /Type is ignored.
+bool SameGraphicsStateDict(const CPDF_Dictionary* wanted,
+                           const CPDF_Dictionary* candidate) {
+  size_t count = 0;
+  {
+    CPDF_DictionaryLocker locker(candidate);
+    for (const auto& entry : locker) {
+      if (entry.first == "Type") {
+        continue;
+      }
+      ++count;
+      RetainPtr<const CPDF_Object> want =
+          wanted->GetDirectObjectFor(entry.first.AsStringView());
+      if (!want || !SameSimpleValue(want.Get(), entry.second->GetDirect().Get())) {
+        return false;
+      }
+    }
+  }
+  return count == wanted->size() - (wanted->KeyExist("Type") ? 1 : 0);
+}
