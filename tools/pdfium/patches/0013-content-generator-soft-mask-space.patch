+RetainPtr<const CPDF_Dictionary> CPDF_PageContentGenerator::GetExtGState(
+    const ByteString& name) {
+  RetainPtr<CPDF_Dictionary> resources = obj_holder_->GetMutableResources();
+  if (!resources) {
+    return nullptr;
+  }
+  RetainPtr<CPDF_Dictionary> ext_gstates =
+      resources->GetMutableDictFor("ExtGState");
+  if (ext_gstates && ext_gstates->KeyExist(name.AsStringView())) {
+    return ext_gstates->GetDictFor(name.AsStringView());
+  }
+  // An object put back after the regeneration that retired its ExtGState (an
+  // undone delete) was written without it, and the entry only came back once the
+  // stream was written.
+  auto& all_removed = obj_holder_->all_removed_resources_map();
+  auto removed_type = all_removed.find("ExtGState");
+  if (removed_type == all_removed.end()) {
+    return nullptr;
+  }
+  auto removed = removed_type->second.find(name);
+  if (removed == removed_type->second.end() || !removed->second) {
+    return nullptr;
+  }
+  RetainPtr<const CPDF_Dictionary> dict =
+      ToDictionary(removed->second->GetDirect());
+  if (!dict) {
+    return nullptr;
+  }
+  if (!ext_gstates) {
+    ext_gstates = resources->SetNewFor<CPDF_Dictionary>("ExtGState");
+  }
+  ext_gstates->SetFor(name, std::move(removed->second));
+  removed_type->second.erase(removed);
+  return dict;
+}
+
+ByteString CPDF_PageContentGenerator::FindEquivalentExtGState(
+    const CPDF_Dictionary* wanted) const {
+  RetainPtr<CPDF_Dictionary> resources = obj_holder_->GetMutableResources();
+  if (!resources) {
+    return ByteString();
+  }
+  RetainPtr<CPDF_Dictionary> ext_gstates =
+      resources->GetMutableDictFor("ExtGState");
+  if (ext_gstates) {
+    CPDF_DictionaryLocker locker(ext_gstates);
+    for (const auto& entry : locker) {
+      RetainPtr<const CPDF_Dictionary> dict =
+          ToDictionary(entry.second->GetDirect());
+      if (dict && SameGraphicsStateDict(wanted, dict.Get())) {
+        return entry.first;
+      }
+    }
+  }
+  auto& all_removed = obj_holder_->all_removed_resources_map();
+  auto removed_type = all_removed.find("ExtGState");
+  if (removed_type == all_removed.end()) {
+    return ByteString();
+  }
+  for (auto it = removed_type->second.begin(); it != removed_type->second.end();
+       ++it) {
+    RetainPtr<const CPDF_Dictionary> dict =
+        it->second ? ToDictionary(it->second->GetDirect()) : nullptr;
+    if (!dict || !SameGraphicsStateDict(wanted, dict.Get())) {
+      continue;
+    }
+    ByteString name = it->first;
+    if (!ext_gstates) {
+      ext_gstates = resources->SetNewFor<CPDF_Dictionary>("ExtGState");
+    }
+    ext_gstates->SetFor(name, std::move(it->second));
+    removed_type->second.erase(it);
+    return name;
+  }
+  return ByteString();
+}
