 namespace {
 
+// The most a reduced copy of a huge image may take (MegaPDF): a 32-megapixel RGB
+// render at the device size, under the page cache's 100 MB limit.
+constexpr uint64_t kMaxReducedImageBytes = 96 * 1024 * 1024;
+
+// A huge image (kHugeImageSize and over) is never realized, and its size keeps it
+// over the page cache's limit, so CacheOptimization() drops it after every render and
+// the next render decodes the whole stream again: over a second for a 20,000 x 15,000
+// px Flate image, at any zoom. When the render needs far fewer pixels, keep an
+// area-averaged copy instead, at twice the device size in each direction where the
+// image has them (as JPX and DCT decoding skip levels), at most
+// kMaxReducedImageBytes, and never under the device size. IsCacheValid() already
+// compares a cached bitmap with the size a later render needs, so a larger render
+// decodes again and replaces the copy. A huge image cached whole (a render too large
+// to reduce for) is reduced the next time a smaller render finds it: its lazy DIB
+// counts as small in the cache, so it is never dropped, and every render through it
+// decodes the stream again. Returns null when there is nothing to gain.
+RetainPtr<CFX_DIBBase> ReduceHugeImage(const RetainPtr<CFX_DIBBase>& image,
+                                       const CFX_Size& required) {
+  if (!image || required.width <= 0 || required.height <= 0 ||
+      image->GetBPP() < 8) {
+    return nullptr;
+  }
+  const uint64_t width = image->GetWidth();
+  const uint64_t height = image->GetHeight();
+  const uint64_t bytes_per_pixel = image->GetBPP() / 8;
+  if (static_cast<uint64_t>(image->GetPitch()) * height < kHugeImageSize) {
+    return nullptr;
+  }
+  for (const uint64_t factor : {4u, 3u, 2u}) {  // in halves: 2x, 1.5x, 1x
+    const uint64_t dest_width =
+        std::min<uint64_t>(width, (required.width * factor + 1) / 2);
+    const uint64_t dest_height =
+        std::min<uint64_t>(height, (required.height * factor + 1) / 2);
+    if (dest_width * dest_height * 4 > width * height) {
+      return nullptr;  // not a quarter of the pixels: keep the upstream path
+    }
+    if (dest_width * dest_height * bytes_per_pixel > kMaxReducedImageBytes) {
+      continue;
+    }
+    return image->StretchTo(static_cast<int>(dest_width),
+                            static_cast<int>(dest_height),
+                            FXDIB_ResampleOptions(), nullptr);
+  }
+  return nullptr;
+}
