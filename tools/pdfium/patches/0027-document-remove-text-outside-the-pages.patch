+namespace {
+
+// Unlinks `entry` from the doubly linked list of its siblings and from its parent's
+// /First and /Last, and corrects the parent's /Count. The subtree beneath it goes with it,
+// because nothing points at it any more and the writer drops what it cannot reach.
+bool UnlinkBookmark(CPDF_Document* doc, const RetainPtr<CPDF_Dictionary>& entry) {
+  RetainPtr<CPDF_Dictionary> parent = entry->GetMutableDictFor("Parent");
+  RetainPtr<CPDF_Dictionary> prev = entry->GetMutableDictFor("Prev");
+  RetainPtr<CPDF_Dictionary> next = entry->GetMutableDictFor("Next");
+
+  if (prev) {
+    if (next) {
+      prev->SetNewFor<CPDF_Reference>("Next", doc, next->GetObjNum());
+    } else {
+      prev->RemoveFor("Next");
+    }
+  }
+  if (next) {
+    if (prev) {
+      next->SetNewFor<CPDF_Reference>("Prev", doc, prev->GetObjNum());
+    } else {
+      next->RemoveFor("Prev");
+    }
+  }
+  if (parent) {
+    if (parent->GetDictFor("First") == entry.Get()) {
+      if (next) {
+        parent->SetNewFor<CPDF_Reference>("First", doc, next->GetObjNum());
+      } else {
+        parent->RemoveFor("First");
+      }
+    }
+    if (parent->GetDictFor("Last") == entry.Get()) {
+      if (prev) {
+        parent->SetNewFor<CPDF_Reference>("Last", doc, prev->GetObjNum());
+      } else {
+        parent->RemoveFor("Last");
+      }
+    }
+    // /Count is the number of open entries below, negative when the entry is closed.
+    const int count = parent->GetIntegerFor("Count");
+    if (count > 0) {
+      parent->SetNewFor<CPDF_Number>("Count", count - 1);
+    } else if (count < 0) {
+      parent->SetNewFor<CPDF_Number>("Count", count + 1);
+    }
+  }
+  entry->RemoveFor("Parent");
+  entry->RemoveFor("Prev");
+  entry->RemoveFor("Next");
+  entry->RemoveFor("First");
+  entry->RemoveFor("Last");
+  entry->RemoveFor("Title");
+  return true;
+}
+
+// Clears the text-bearing keys of `element` and its children when they carry `text`.
+int ClearStructureText(const RetainPtr<CPDF_Dictionary>& element,
+                       const WideString& text,
+                       int depth) {
+  if (!element || depth > 64) {
+    return 0;
+  }
+  int cleared = 0;
+  static const char* const kTextKeys[] = {"ActualText", "Alt", "E", "TU"};
+  for (const char* key : kTextKeys) {
+    RetainPtr<const CPDF_Object> value = element->GetObjectFor(key);
+    if (!value || !value->IsString()) {
+      continue;
+    }
+    if (value->GetUnicodeText().Contains(text.AsStringView())) {
+      element->RemoveFor(key);
+      ++cleared;
+    }
+  }
+  RetainPtr<CPDF_Array> kids = element->GetMutableArrayFor("K");
+  if (kids) {
+    for (size_t i = 0; i < kids->size(); ++i) {
+      cleared += ClearStructureText(kids->GetMutableDictAt(i), text, depth + 1);
+    }
+  } else {
+    cleared += ClearStructureText(element->GetMutableDictFor("K"), text, depth + 1);
+  }
+  return cleared;
+}
+
+}  // namespace
