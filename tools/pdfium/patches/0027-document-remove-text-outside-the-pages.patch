+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV FPDFBookmark_Remove(FPDF_DOCUMENT document,
+                                                        FPDF_BOOKMARK bookmark) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_Dictionary* entry = CPDFDictionaryFromFPDFBookmark(bookmark);
+  if (!doc || !entry) {
+    return false;
+  }
+  return UnlinkBookmark(doc, pdfium::WrapRetain(entry));
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDF_RemovePageLabels(FPDF_DOCUMENT document) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  if (!doc) {
+    return false;
+  }
+  RetainPtr<CPDF_Dictionary> root = doc->GetMutableRoot();
+  return root && root->RemoveFor("PageLabels");
+}
+
+FPDF_EXPORT int FPDF_CALLCONV
+FPDF_RemoveStructureTextMatching(FPDF_DOCUMENT document, FPDF_WIDESTRING text) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  if (!doc || !text) {
+    return -1;
+  }
+  const WideString needle = WideStringFromFPDFWideString(text);
+  if (needle.IsEmpty()) {
+    return 0;
+  }
+  RetainPtr<CPDF_Dictionary> root = doc->GetMutableRoot();
+  RetainPtr<CPDF_Dictionary> tree = root ? root->GetMutableDictFor("StructTreeRoot") : nullptr;
+  if (!tree) {
+    return 0;
+  }
+  return ClearStructureText(tree, needle, 0);
+}
+
+FPDF_EXPORT int FPDF_CALLCONV FPDF_RemoveMetadata(FPDF_DOCUMENT document) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  if (!doc) {
+    return -1;
+  }
+
+  int removed = 0;
+  RetainPtr<CPDF_Dictionary> info = doc->GetInfo();
+  if (info) {
+    // The dictionary itself is left in place and emptied: the trailer's /Info reference is
+    // the parser's, not ours to unpick, and an empty dictionary carries nothing.
+    //
+    // The keys are collected first and the locker released before anything is removed: a
+    // CPDF_Dictionary CHECKs that it is not modified while one is alive.
+    std::vector<ByteString> keys;
+    {
+      CPDF_DictionaryLocker locker(info);
+      for (const auto& it : locker) {
+        keys.push_back(it.first);
+      }
+    }
+    for (const ByteString& key : keys) {
+      info->RemoveFor(key.AsStringView());
+      ++removed;
+    }
+  }
+
+  RetainPtr<CPDF_Dictionary> root = doc->GetMutableRoot();
+  if (root) {
+    if (root->RemoveFor("Metadata")) {
+      ++removed;
+    }
+    if (root->RemoveFor("PieceInfo")) {
+      ++removed;
+    }
+  }
+
+  const int pages = doc->GetPageCount();
+  for (int i = 0; i < pages; ++i) {
+    RetainPtr<CPDF_Dictionary> page = doc->GetMutablePageDictionary(i);
+    if (!page) {
+      continue;
+    }
+    if (page->RemoveFor("Metadata")) {
+      ++removed;
+    }
+    if (page->RemoveFor("PieceInfo")) {
+      ++removed;
+    }
+  }
+  return removed;
+}
