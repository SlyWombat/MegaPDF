+// A classic cross-reference entry is exactly 20 bytes, of which the offset is exactly ten
+// digits (PDF 1.7, 7.5.4 "Cross-Reference Table"). `object_offsets_` holds FX_FILESIZE,
+// and "%010d" formatted the low 32 bits of it as a signed int, so in a file over 2 GiB
+// every object past that point was listed at a negative offset -- including, in a real
+// 2.68 GB file, the document catalog, which no reader could then find (#267).
+//
+// Ten digits cannot express an offset of 10^10 or more, in any format string: such a file
+// has no valid classic table, so the save is refused rather than written unreadable.
+constexpr FX_FILESIZE kMaxClassicXRefOffset = 9999999999;
+
+bool WriteXRefEntry(IFX_ArchiveStream* archive, FX_FILESIZE offset) {
+  if (offset < 0 || offset > kMaxClassicXRefOffset) {
+    return false;
+  }
+  return archive->WriteString(
+      ByteString::Format("%010lld 00000 n\r\n", static_cast<long long>(offset))
+          .AsStringView());
+}
+
+// The width in bytes of a cross-reference stream's offset field (the second entry of
+// /W). Four while every offset fits in four bytes, which is every file under 4 GiB and so
+// every file this writer produced before, whose bytes do not change (#267).
+int XRefStreamOffsetWidth(FX_FILESIZE max_offset) {
+  int width = 4;
+  while (width < 8 &&
+         max_offset >= (static_cast<FX_FILESIZE>(1) << (8 * width))) {
+    width++;
+  }
+  return width;
+}
+
+bool OutputIndex(IFX_ArchiveStream* archive, FX_FILESIZE offset, int width) {
+  for (int shift = 8 * (width - 1); shift >= 0; shift -= 8) {
+    if (!archive->WriteByte(static_cast<uint8_t>((offset >> shift) & 0xff))) {
+      return false;
+    }
+  }
+  return archive->WriteByte(0);
 }
 
