+FPDF_EXPORT FPDF_CLIPPATH FPDF_CALLCONV
+FPDF_CreateClipPathFromRects(const FS_RECTF* rects,
+                             size_t count,
+                             FPDF_BOOL even_odd) {
+  if (!rects || count == 0) {
+    return nullptr;
+  }
+
+  // One path, one subpath per rectangle: the fill rule then decides how they combine,
+  // which is the only way the API can describe a region with a hole in it.
+  CPDF_Path path;
+  for (size_t i = 0; i < count; ++i) {
+    path.AppendRect(rects[i].left, rects[i].bottom, rects[i].right, rects[i].top);
+  }
+
+  auto new_clip_path = std::make_unique<CPDF_ClipPath>();
+  new_clip_path->AppendPath(path, even_odd
+                                      ? CFX_FillRenderOptions::FillType::kEvenOdd
+                                      : CFX_FillRenderOptions::FillType::kWinding);
+
+  // Caller takes ownership.
+  return FPDFClipPathFromCPDFClipPath(new_clip_path.release());
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFPageObj_AppendClipPath(FPDF_PAGEOBJECT page_object, FPDF_CLIPPATH clip_path) {
+  CPDF_PageObject* page_obj = CPDFPageObjectFromFPDFPageObject(page_object);
+  CPDF_ClipPath* clip = CPDFClipPathFromFPDFClipPath(clip_path);
+  if (!page_obj || !clip || !clip->HasRef()) {
+    return false;
+  }
+
+  CPDF_ClipPath& target = page_obj->mutable_clip_path();
+  if (!target.HasRef()) {
+    target.Emplace();
+  }
+  for (size_t i = 0; i < clip->GetPathCount(); ++i) {
+    target.AppendPath(clip->GetPath(i), clip->GetClipType(i));
+  }
+  page_obj->SetDirty(true);
+  return true;
+}
+
