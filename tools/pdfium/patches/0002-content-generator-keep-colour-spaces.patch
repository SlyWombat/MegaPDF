 // "W" and "W*" modify the clipping path using the nonzero winding rule and
 // even-odd rules, respectively.
 // "q" saves the graphics state, so that the settings can later be reversed
+ByteString CPDF_PageContentGenerator::RealizeResourceOnce(
+    const CPDF_Object* resource,
+    ByteStringView type) {
+  const auto key = std::make_pair(ByteString(type), resource);
+  auto it = realized_resources_.find(key);
+  if (it != realized_resources_.end()) {
+    return it->second;
+  }
+  const CPDF_Object* indirect = resource;
+  if (resource->GetObjNum() == 0) {
+    RetainPtr<CPDF_Object> copy = resource->Clone();
+    document_->AddIndirectObject(copy);
+    indirect = copy.Get();
+  }
+  ByteString name = RealizeResource(indirect, type);
+  realized_resources_[key] = name;
+  return name;
+}
+
+void CPDF_PageContentGenerator::WriteColor(fxcrt::ostringstream* buf,
+                                           const CPDF_Color* color,
+                                           bool stroke) {
+  if (!color || color->IsNull()) {
+    return;
+  }
+  // DeviceRGB and DeviceGray keep the form this writer has always used.
+  if (WriteColorToStream(*buf, color)) {
+    *buf << (stroke ? " RG " : " rg ");
+    return;
+  }
+  RetainPtr<CPDF_ColorSpace> colorspace = color->GetColorSpace();
+  if (!colorspace) {
+    return;
+  }
+  if (color->IsPattern()) {
+    // Coloured patterns only. An uncoloured one is set through a [/Pattern base]
+    // space with components as well, which is not carried here yet.
+    RetainPtr<CPDF_Pattern> pattern = color->GetPattern();
+    RetainPtr<const CPDF_Object> pattern_obj =
+        pattern ? pattern->GetPatternObject() : nullptr;
+    if (!pattern_obj || colorspace->GetArray()) {
+      return;
+    }
+    const ByteString name = RealizeResourceOnce(pattern_obj.Get(), "Pattern");
+    *buf << "/Pattern " << (stroke ? "CS" : "cs") << " /"
+         << PDF_NameEncode(name) << " " << (stroke ? "SCN" : "scn") << " ";
+    return;
+  }
+  pdfium::span<const float> values = color->GetNonPatternValues();
+  const size_t count =
+      std::min<size_t>(colorspace->ComponentCount(), values.size());
+  if (count == 0) {
+    return;
+  }
+  RetainPtr<const CPDF_Array> array = colorspace->GetArray();
+  if (!array) {
+    if (colorspace->GetFamily() != CPDF_ColorSpace::Family::kDeviceCMYK ||
+        count != 4) {
+      return;
+    }
+    for (size_t i = 0; i < count; ++i) {
+      WriteFloat(*buf, values[i]) << " ";
+    }
+    *buf << (stroke ? "K " : "k ");
+    return;
+  }
+  const ByteString name = RealizeResourceOnce(array.Get(), "ColorSpace");
+  *buf << "/" << PDF_NameEncode(name) << " " << (stroke ? "CS " : "cs ");
+  for (size_t i = 0; i < count; ++i) {
+    WriteFloat(*buf, values[i]) << " ";
+  }
+  *buf << (stroke ? "SCN " : "scn ");
+}
