 void CPDF_Creator::RemoveSecurity() {
   security_handler_.Reset();
   security_changed_ = true;
+  // Clearing `encrypt_dict_` stops the copy being enciphered and keeps /Encrypt out
+  // of the trailer, but it does not stop the body writing the security out. The body
+  // writes every object in GetObjectsWithReferences(), whose walk starts at the
+  // *parser's* trailer -- the one the file was read with, which still says
+  // /Encrypt N 0 R. Two objects stay reachable through it and are copied verbatim
+  // into the plain file (#241):
+  //
+  //   * the encryption dictionary, an orphan carrying /O, /U, /OE, /UE, /Perms and
+  //     the old /P, so the original password can still be attacked offline from a
+  //     file the user asked to have protection removed from;
+  //   * when the cross-reference is a stream, that stream is itself the trailer and
+  //     has an object number of its own, so the old cross-reference stream is
+  //     written out too -- and its dictionary still says /Encrypt N 0 R.
+  //
+  // The new file has its own cross-reference, and nothing in it refers to either, so
+  // both are left out. This only applies to a save that removes security; an ordinary
+  // save writes exactly what it wrote before.
+  if (encrypt_dict_) {
+    removed_encrypt_obj_num_ = encrypt_dict_->GetObjNum();
+  }
+  if (parser_) {
+    removed_trailer_obj_num_ = parser_->GetTrailerObjectNumber();
+  }
   encrypt_dict_ = nullptr;
   new_encrypt_dict_.Reset();
 }
 
+// Object numbers start at 1, so 0 means there is nothing to leave out. An inline
+// trailer has no object number, and neither does an inline encryption dictionary.
+bool CPDF_Creator::LeftOutBySecurityRemoval(uint32_t objnum) const {
+  if (objnum == 0) {
+    return false;
+  }
+  return objnum == removed_encrypt_obj_num_ || objnum == removed_trailer_obj_num_;
+}
+
 CPDF_CryptoHandler* CPDF_Creator::GetCryptoHandler() {
   return security_handler_ ? security_handler_->GetCryptoHandler() : nullptr;
 }
