@@ -761,10 +764,25 @@
 void CPDF_Creator::RemoveSecurity() {
   security_handler_.Reset();
   security_changed_ = true;
+  // Clearing `encrypt_dict_` stops the copy being enciphered and keeps /Encrypt out
+  // of the trailer, but it does not stop the body writing the dictionary out. The
+  // body writes every object in GetObjectsWithReferences(), whose walk starts at the
+  // *parser's* trailer -- the one the file was read with, which still says
+  // /Encrypt N 0 R. So object N stayed reachable and was copied verbatim into the
+  // plain file, an orphan carrying /O, /U, /OE, /UE, /Perms and the old /P (#241).
+  // Remember its number and leave it out.
+  if (encrypt_dict_) {
+    removed_encrypt_obj_num_ = encrypt_dict_->GetObjNum();
+  }
   encrypt_dict_ = nullptr;
   new_encrypt_dict_.Reset();
 }
 
+// Object numbers start at 1, so 0 means there is nothing to leave out.
+bool CPDF_Creator::IsRemovedEncryptDict(uint32_t objnum) const {
+  return removed_encrypt_obj_num_ != 0 && objnum == removed_encrypt_obj_num_;
+}
+
 CPDF_CryptoHandler* CPDF_Creator::GetCryptoHandler() {
   return security_handler_ ? security_handler_->GetCryptoHandler() : nullptr;
 }
