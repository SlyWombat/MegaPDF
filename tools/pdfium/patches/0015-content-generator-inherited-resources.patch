+// Whether `page_object` draws with resources it does not name: a form XObject
+// with no /Resources of its own, or text in a Type3 font without them, uses the
+// page's (CPDF_Form::ChooseResourcesDict, CPDF_Type3Font::LoadChar). The images,
+// fonts and graphics states its content names never appear on the page's own
+// objects, so pruning by those objects removed them, and the form or glyph drew
+// without them once the page was parsed again.
+bool DrawsWithPageResources(const CPDF_PageObject* page_object) {
+  if (const CPDF_FormObject* form_object = page_object->AsForm()) {
+    RetainPtr<const CPDF_Dictionary> form_dict =
+        form_object->form() ? form_object->form()->GetDict() : nullptr;
+    return form_dict && !form_dict->GetDictFor("Resources");
+  }
+  if (const CPDF_TextObject* text_object = page_object->AsText()) {
+    RetainPtr<CPDF_Font> font = text_object->GetFont();
+    return font && font->IsType3Font() && font->GetFontDict() &&
+           !font->GetFontDict()->GetDictFor("Resources");
+  }
+  return false;
+}
