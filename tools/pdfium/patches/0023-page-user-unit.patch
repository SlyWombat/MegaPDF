+FPDF_EXPORT float FPDF_CALLCONV FPDFPage_GetUserUnit(FPDF_PAGE page) {
+  const CPDF_Page* pPage = CPDFPageFromFPDFPage(page);
+  if (!pPage) {
+    return 1.0f;
+  }
+  RetainPtr<const CPDF_Number> unit =
+      ToNumber(pPage->GetDict()->GetDirectObjectFor("UserUnit"));
+  if (!unit) {
+    return 1.0f;
+  }
+  const float value = unit->GetNumber();
+  return std::isfinite(value) && value > 0.0f ? value : 1.0f;
+}
