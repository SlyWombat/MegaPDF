+ByteString CPDF_PageContentGenerator::FindDirectFont(
+    const CPDF_Object* font_dict,
+    const ByteString& current_name) {
+  RetainPtr<CPDF_Dictionary> resources = obj_holder_->GetMutableResources();
+  if (!resources) {
+    return ByteString();
+  }
+  RetainPtr<CPDF_Dictionary> fonts = resources->GetMutableDictFor("Font");
+  if (fonts) {
+    if (!current_name.IsEmpty() &&
+        fonts->GetObjectFor(current_name.AsStringView()).Get() == font_dict) {
+      return current_name;
+    }
+    CPDF_DictionaryLocker locker(fonts);
+    for (const auto& entry : locker) {
+      if (entry.second.Get() == font_dict) {
+        return entry.first;
+      }
+    }
+  }
+  auto& all_removed = obj_holder_->all_removed_resources_map();
+  auto removed_type = all_removed.find("Font");
+  if (removed_type == all_removed.end()) {
+    return ByteString();
+  }
+  for (auto it = removed_type->second.begin(); it != removed_type->second.end();
+       ++it) {
+    if (it->second.Get() != font_dict) {
+      continue;
+    }
+    ByteString name = it->first;
+    if (!fonts) {
+      fonts = resources->SetNewFor<CPDF_Dictionary>("Font");
+    }
+    fonts->SetFor(name, std::move(it->second));
+    removed_type->second.erase(it);
+    return name;
+  }
+  return ByteString();
+}
