+void CPDF_PageImageCache::Entry::ReduceCached(
+    const CFX_Size& max_size_required) {
+  // A copy already reduced stays: reducing it again for a smaller render would make
+  // the next render at its own size decode the whole image again.
+  if (!cached_bitmap_ || cached_reduced_ || max_size_required.width == 0 ||
+      max_size_required.height == 0 || !IsCacheValid(max_size_required)) {
+    return;
+  }
+  bool reduced_any = false;
+  if (RetainPtr<CFX_DIBBase> reduced =
+          ReduceHugeImage(cached_bitmap_, max_size_required)) {
+    cached_bitmap_ = std::move(reduced);
+    reduced_any = true;
+  }
+  if (RetainPtr<CFX_DIBBase> reduced =
+          ReduceHugeImage(cached_mask_, max_size_required)) {
+    cached_mask_ = std::move(reduced);
+    reduced_any = true;
+  }
+  if (reduced_any) {
+    cached_reduced_ = true;
+    cached_set_max_size_required_ = true;
+    max_size_required_ = max_size_required;
+    CalcSize();
+  }
+}
