+// Removes `field` from `fields`, recursing through each entry's /Kids. A parent left with
+// no kids is removed with it, so nothing is left pointing at a field that is gone.
+bool RemoveFieldFromArray(CPDF_Array* fields,
+                          const CPDF_Dictionary* field,
+                          int depth) {
+  if (!fields || !field || depth > 32) {
+    return false;
+  }
+  for (size_t i = 0; i < fields->size(); ++i) {
+    RetainPtr<CPDF_Dictionary> entry = fields->GetMutableDictAt(i);
+    if (!entry) {
+      continue;
+    }
+    if (entry.Get() == field) {
+      fields->RemoveAt(i);
+      return true;
+    }
+    RetainPtr<CPDF_Array> kids = entry->GetMutableArrayFor("Kids");
+    if (kids && RemoveFieldFromArray(kids.Get(), field, depth + 1)) {
+      if (kids->IsEmpty()) {
+        fields->RemoveAt(i);
+      }
+      return true;
+    }
+  }
+  return false;
+}
