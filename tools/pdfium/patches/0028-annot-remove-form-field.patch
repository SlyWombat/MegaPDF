+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFDoc_RemoveFormField(FPDF_DOCUMENT document, FPDF_ANNOTATION annot) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (!doc || !context) {
+    return false;
+  }
+  RetainPtr<CPDF_Dictionary> annot_dict = context->GetMutableAnnotDict();
+  if (!annot_dict) {
+    return false;
+  }
+
+  // A widget and its field are one dictionary when the producer merged them, and two when
+  // the field has several widgets; then the field is the nearest ancestor with an /FT.
+  RetainPtr<CPDF_Dictionary> field = annot_dict;
+  for (int depth = 0; field && !field->KeyExist("FT") && depth < 32; ++depth) {
+    field = field->GetMutableDictFor("Parent");
+  }
+  if (!field) {
+    return false;
+  }
+
+  // Clear what carries the value first: the field dictionary may still be reachable from
+  // somewhere this does not walk, and an empty one leaks nothing.
+  static const char* const kValueKeys[] = {"V", "DV", "RV", "TU", "AP"};
+  for (const char* key : kValueKeys) {
+    field->RemoveFor(key);
+  }
+  if (field.Get() != annot_dict.Get()) {
+    for (const char* key : kValueKeys) {
+      annot_dict->RemoveFor(key);
+    }
+  }
+
+  RetainPtr<CPDF_Dictionary> root = doc->GetMutableRoot();
+  RetainPtr<CPDF_Dictionary> acro_form =
+      root ? root->GetMutableDictFor("AcroForm") : nullptr;
+  RetainPtr<CPDF_Array> fields =
+      acro_form ? acro_form->GetMutableArrayFor("Fields") : nullptr;
+  RemoveFieldFromArray(fields.Get(), field.Get(), 0);
+  return true;
+}
