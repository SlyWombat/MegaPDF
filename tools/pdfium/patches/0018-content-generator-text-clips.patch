+  // Text clips (#125). Glyphs shown in a clipping mode (4-7 Tr) clip everything
+  // drawn after their "ET" in the same saved state, and PDFium keeps each
+  // BT ... ET group's glyphs with the clip of the objects after it. Only path
+  // clips were written, and the clipping text is written as its own object inside
+  // q ... Q, so its clip ended there: an image drawn through a word covered the
+  // page. Each group is written as the path PDFium's renderer clips to, the union
+  // of its glyph outlines filled with the nonzero rule; written as text it would
+  // come back as more text objects every time the page is parsed. A group in a
+  // font whose glyphs are not outlines here is left out, which clips less.
+  const size_t text_count = clip_path.GetTextCount();
+  size_t i = 0;
+  while (i < text_count) {
+    CPDF_Path group;
+    bool outlined = true;
+    size_t glyph_objects = 0;
+    for (; i < text_count; ++i) {
+      CPDF_TextObject* text = clip_path.GetText(i);
+      if (!text) {
+        ++i;
+        break;
+      }
+      ++glyph_objects;
+      outlined = AppendGlyphOutlines(text, &group) && outlined;
+    }
+    if (glyph_objects == 0 || !outlined) {
+      continue;
+    }
+    if (!group.HasRef() || group.GetPoints().empty()) {
+      // Clipping text with no outline (spaces) leaves nothing visible.
+      *buf << "0 0 0 0 re W n ";
+      continue;
+    }
+    ProcessPathPoints(buf, &group);
+    *buf << " W n ";
+  }
