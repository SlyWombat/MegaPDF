+// Appends the outlines of `text`'s glyphs, in page space, to `out`: what PDFium's
+// renderer accumulates for text used as a clip (CPDF_TextRenderer::DrawTextPath
+// with a clipping path). False for a font whose glyphs are not outlines here.
+bool AppendGlyphOutlines(CPDF_TextObject* text, CPDF_Path* out) {
+  RetainPtr<CPDF_Font> font = text->GetFont();
+  if (!font || font->IsType3Font()) {
+    return false;
+  }
+  const float font_size = text->GetFontSize();
+  CFX_Matrix text_matrix = text->GetTextMatrix();
+  std::vector<TextCharPos> positions = font->GetCharPosList(
+      text->GetCharCodes(), text->GetCharPositions(), font_size);
+  for (const TextCharPos& charpos : positions) {
+    CFX_Font* glyph_font = charpos.fallback_font_position_ == -1
+                               ? font->GetFont()
+                               : font->GetFontFallback(
+                                     charpos.fallback_font_position_);
+    if (!glyph_font) {
+      continue;
+    }
+    const CFX_Path* glyph = glyph_font->LoadGlyphPath(
+        charpos.glyph_index_, charpos.font_char_width_);
+    if (!glyph) {
+      continue;
+    }
+    CFX_Matrix matrix(font_size, 0, 0, font_size, charpos.origin_.x,
+                      charpos.origin_.y);
+    matrix = charpos.GetEffectiveMatrix(matrix);
+    matrix.Concat(text_matrix);
+    out->Append(*glyph, &matrix);
+  }
+  return true;
+}
