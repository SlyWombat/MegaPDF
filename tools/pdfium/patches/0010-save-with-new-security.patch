+void CPDF_SecurityHandler::OnCreateAES256(CPDF_Dictionary* pEncryptDict,
+                                          const ByteString& user_password,
+                                          const ByteString& owner_password) {
+  DCHECK(pEncryptDict);
+
+  CPDF_CryptoHandler::Cipher cipher = CPDF_CryptoHandler::Cipher::kNone;
+  size_t key_len = 0;
+  if (!LoadDict(pEncryptDict, &cipher, &key_len) || revision_ != 6 ||
+      cipher != CPDF_CryptoHandler::Cipher::kAES || key_len != 32) {
+    return;
+  }
+
+  // A random 256-bit file key. OnCreate()'s revision 5 branch seeds it from
+  // four random words; this takes eight.
+  uint32_t random[8];
+  FX_Random::Fill(random);
+  CryptSha2Context sha;
+  CryptSha256Start(&sha);
+  CryptSha256Update(&sha, pdfium::as_byte_span(random));
+  CryptSha256Finish(&sha, encrypt_key_);
+
+  AES256_SetPassword(pEncryptDict, user_password);
+  AES256_SetOwnerPassword(pEncryptDict, owner_password);
+  AES256_SetPerms(pEncryptDict);
+  InitCryptoHandler();
+}
+
+// ISO 32000-2 Algorithm 9: the owner entries, which hash with the 48 bytes of U
+// that AES256_SetPassword() has just written. Laid out like U and UE: a 32-byte
+// hash, then the 8-byte validation salt and the 8-byte key salt.
+void CPDF_SecurityHandler::AES256_SetOwnerPassword(
+    CPDF_Dictionary* pEncryptDict,
+    const ByteString& password) {
+  const ByteString ukey = pEncryptDict->GetByteStringFor("U");
+  CHECK_GE(ukey.GetLength(), 48u);
+  const pdfium::span<const uint8_t, 48> udata =
+      ukey.unsigned_span().first<48u>();
+
+  CryptSha1Context sha;
+  CryptSha1Start(&sha);
+  CryptSha1Update(&sha, encrypt_key_);
+  CryptSha1Update(&sha, pdfium::as_byte_span("owner").first<5u>());
+  uint8_t digest[20];
+  CryptSha1Finish(&sha, digest);
+
+  uint8_t digest1[48];
+  Revision6_Hash(password, pdfium::span(digest).first<8u>(), udata,
+                 pdfium::span(digest1).first<32u>());
+  fxcrt::Copy(pdfium::span(digest).first<16u>(),
+              pdfium::span(digest1).subspan<32u>());
+  pEncryptDict->SetNewFor<CPDF_String>(
+      "O", ByteString(ByteStringView(pdfium::span(digest1))));
+
+  Revision6_Hash(password, pdfium::span(digest).subspan<8u, 8u>(), udata,
+                 pdfium::span(digest1).first<32u>());
+  CRYPT_aes_context aes = {};
+  CRYPT_AESSetKey(&aes, pdfium::span(digest1).first<32>());
+  uint8_t iv[16] = {};
+  CRYPT_AESSetIV(&aes, iv);
+  CRYPT_AESEncrypt(&aes, digest1, encrypt_key_);
+  pEncryptDict->SetNewFor<CPDF_String>(
+      "OE", ByteString(ByteStringView(pdfium::span(digest1).first<32>())));
+}
