+void CPDF_Creator::SetSecurity(const ByteString& user_password,
+                               const ByteString& owner_password,
+                               uint32_t permissions) {
+  set_security_ = true;
+  security_user_ = user_password;
+  security_owner_ = owner_password;
+  security_permissions_ = permissions;
+}
+
+// Encrypts the copy with the standard security handler at revision 6 (AES-256,
+// ISO 32000-2), in place of whatever security the document had. The dictionary
+// is inline, so kWriteEncryptDict27 gives it the next object number, and a
+// security change always writes every object again.
+bool CPDF_Creator::ApplyNewSecurity() {
+  RetainPtr<CPDF_Dictionary> dict = document_->New<CPDF_Dictionary>();
+  dict->SetNewFor<CPDF_Name>("Filter", "Standard");
+  dict->SetNewFor<CPDF_Number>("V", 5);
+  dict->SetNewFor<CPDF_Number>("R", 6);
+  dict->SetNewFor<CPDF_Number>("Length", 256);
+  RetainPtr<CPDF_Dictionary> filters = dict->SetNewFor<CPDF_Dictionary>("CF");
+  RetainPtr<CPDF_Dictionary> std_cf =
+      filters->SetNewFor<CPDF_Dictionary>("StdCF");
+  std_cf->SetNewFor<CPDF_Name>("CFM", "AESV3");
+  std_cf->SetNewFor<CPDF_Name>("AuthEvent", "DocOpen");
+  std_cf->SetNewFor<CPDF_Number>("Length", 32);
+  dict->SetNewFor<CPDF_Name>("StmF", "StdCF");
+  dict->SetNewFor<CPDF_Name>("StrF", "StdCF");
+  // Bits 7-8 and 13-32 of P must be set (ISO 32000-2, Table 22).
+  dict->SetNewFor<CPDF_Number>(
+      "P", static_cast<int>(security_permissions_ | 0xFFFFF0C0u));
+  dict->SetNewFor<CPDF_Boolean>("EncryptMetadata", true);
+
+  auto handler = pdfium::MakeRetain<CPDF_SecurityHandler>();
+  handler->OnCreateAES256(dict.Get(), security_user_, security_owner_);
+  if (!handler->GetCryptoHandler()) {
+    return false;
+  }
+
+  new_encrypt_dict_ = dict;
+  encrypt_dict_ = new_encrypt_dict_;
+  security_handler_ = std::move(handler);
+  security_changed_ = true;
+  return true;
+}
