 // Processing path painting with operators from Table 4.10 of PDF spec 1.7:
 // Path painting operators: "S", "n", "B", "f", "B*", "f*", depending on
 // the filling mode and whether we want stroking the path or not.
+// A shading painted with "sh": the shading dictionary as a resource, drawn under
+// the object's graphics state and clip, in the space it was painted in.
+void CPDF_PageContentGenerator::ProcessShading(
+    fxcrt::ostringstream* buf,
+    CPDF_ShadingObject* shading_obj) {
+  const CPDF_ShadingPattern* pattern = shading_obj->pattern();
+  RetainPtr<const CPDF_Object> shading =
+      pattern ? pattern->GetShadingObject() : nullptr;
+  if (!shading) {
+    return;
+  }
+  ProcessGraphics(buf, shading_obj);
+  const CFX_Matrix& matrix = shading_obj->matrix();
+  if (!matrix.IsIdentity()) {
+    WriteMatrix(*buf, matrix) << " cm ";
+  }
+  const ByteString name = RealizeResourceOnce(shading.Get(), "Shading");
+  *buf << "/" << PDF_NameEncode(name) << " sh";
+  EndProcessGraphics(*buf);
+}
