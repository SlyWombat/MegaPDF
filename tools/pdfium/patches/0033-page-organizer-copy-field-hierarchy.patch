+uint32_t CPDF_PageExporter::CopyFieldAncestor(
+    RetainPtr<const CPDF_Dictionary> src_field) {
+  if (!src_field) {
+    return 0;
+  }
+
+  uint32_t src_obj_num = src_field->GetObjNum();
+  if (src_obj_num) {
+    uint32_t mapped = GetObjectMapping(src_obj_num);
+    if (mapped) {
+      return mapped;
+    }
+  }
+
+  RetainPtr<CPDF_Dictionary> dest_field = ToDictionary(src_field->Clone());
+  if (!dest_field) {
+    return 0;
+  }
+  // Rebuilt below, from only the parts of the hierarchy this export keeps.
+  dest_field->RemoveFor(pdfium::form_fields::kKids);
+  dest_field->RemoveFor(pdfium::form_fields::kParent);
+
+  uint32_t dest_obj_num = dest()->AddIndirectObject(dest_field);
+  if (src_obj_num) {
+    // Mapped before recursing into /Parent or /Kids below, so a field that
+    // is (invalidly) its own ancestor cannot recurse forever: the second
+    // visit finds this mapping and returns immediately.
+    AddObjectMapping(src_obj_num, dest_obj_num);
+  }
+  UpdateReference(dest_field);
+
+  RetainPtr<const CPDF_Dictionary> src_parent =
+      src_field->GetDictFor(pdfium::form_fields::kParent);
+  if (src_parent) {
+    uint32_t dest_parent_num = CopyFieldAncestor(src_parent);
+    if (dest_parent_num) {
+      dest_field->SetNewFor<CPDF_Reference>(pdfium::form_fields::kParent,
+                                            dest(), dest_parent_num);
+    }
+  } else {
+    RegisterRootField(dest_obj_num);
+  }
+
+  RetainPtr<const CPDF_Array> src_kids =
+      src_field->GetArrayFor(pdfium::form_fields::kKids);
+  if (src_kids) {
+    RetainPtr<CPDF_Array> dest_kids;
+    for (size_t i = 0; i < src_kids->size(); ++i) {
+      RetainPtr<const CPDF_Dictionary> src_kid = src_kids->GetDictAt(i);
+      if (!src_kid) {
+        continue;
+      }
+      // A terminal kid is the widget annotation itself: keep it only if it
+      // is one this exporter has already placed on a copied page. A
+      // non-terminal kid is another field node one level down the
+      // hierarchy: recurse, which keeps it only if it still has a kid of
+      // its own once the same rule is applied all the way down.
+      const bool is_widget =
+          src_kid->GetNameFor(pdfium::annotation::kSubtype) == "Widget";
+      const uint32_t dest_kid_num =
+          is_widget ? GetObjectMapping(src_kid->GetObjNum())
+                    : CopyFieldAncestor(src_kid);
+      if (!dest_kid_num) {
+        continue;
+      }
+      if (!dest_kids) {
+        dest_kids = dest_field->SetNewFor<CPDF_Array>(pdfium::form_fields::kKids);
+      }
+      dest_kids->AppendNew<CPDF_Reference>(dest(), dest_kid_num);
+    }
+  }
+
+  return dest_obj_num;
+}
+
+void CPDF_PageExporter::RegisterRootField(uint32_t dest_field_obj_num) {
+  if (!dest_field_obj_num ||
+      !registered_root_fields_.insert(dest_field_obj_num).second) {
+    return;
+  }
+  RetainPtr<CPDF_Dictionary> root = dest()->GetMutableRoot();
+  if (!root) {
+    return;
+  }
+  RetainPtr<CPDF_Dictionary> acroform = root->GetOrCreateDictFor("AcroForm");
+  RetainPtr<CPDF_Array> fields = acroform->GetOrCreateArrayFor("Fields");
+  fields->AppendNew<CPDF_Reference>(dest(), dest_field_obj_num);
+}
+
+void CPDF_PageExporter::CopyFormFieldHierarchies(
+    pdfium::span<const uint32_t> page_indices) {
+  for (uint32_t page_index : page_indices) {
+    RetainPtr<const CPDF_Dictionary> src_page_dict =
+        src()->GetPageDictionary(page_index);
+    if (!src_page_dict) {
+      continue;
+    }
+    RetainPtr<const CPDF_Array> annots = src_page_dict->GetArrayFor("Annots");
+    if (!annots) {
+      continue;
+    }
+    for (size_t i = 0; i < annots->size(); ++i) {
+      RetainPtr<const CPDF_Dictionary> src_widget = annots->GetDictAt(i);
+      if (!src_widget ||
+          src_widget->GetNameFor(pdfium::annotation::kSubtype) != "Widget") {
+        continue;
+      }
+      RetainPtr<const CPDF_Dictionary> src_parent =
+          src_widget->GetDictFor(pdfium::form_fields::kParent);
+      if (!src_parent) {
+        continue;  // its own field, not a hierarchy: already copied whole.
+      }
+      uint32_t dest_widget_num = GetObjectMapping(src_widget->GetObjNum());
+      if (!dest_widget_num) {
+        continue;  // should not happen: it is on a page just exported.
+      }
+      uint32_t dest_parent_num = CopyFieldAncestor(src_parent);
+      if (!dest_parent_num) {
+        continue;
+      }
+      RetainPtr<CPDF_Object> dest_widget_obj =
+          dest()->GetMutableIndirectObject(dest_widget_num);
+      CPDF_Dictionary* dest_widget =
+          dest_widget_obj ? dest_widget_obj->AsMutableDictionary() : nullptr;
+      if (dest_widget) {
+        dest_widget->SetNewFor<CPDF_Reference>(pdfium::form_fields::kParent,
+                                               dest(), dest_parent_num);
+      }
+    }
+  }
+}
