# Generated attribution files are compared byte-for-byte by the CI drift check
# (tools/gen_third_party_notices.py writes LF). Pin them so a Windows checkout
# can't rewrite the line endings and make a regenerated file look changed.
THIRD-PARTY-NOTICES.txt text eol=lf

# The PDFium patch series is hashed into every build's VERSION, and git apply needs
# the patches byte-identical on every runner. A Windows checkout converted them to
# CRLF, so the win-x64 build reported a different series.
tools/pdfium/patches/*.patch text eol=lf
tools/pdfium/*.sh text eol=lf

# Contract 9 golden block dumps (#142, #353) are compared close to byte-for-byte by
# core/tests/core_tests.cpp's test_structure_golden(), written with LF. Same trap as the
# PDFium patches above: an unpinned Windows checkout converts them to CRLF, and every line
# of every dump then reads as "different" (#359 — this is what actually made all 14
# fixtures fail on windows-latest, not only the ones with a real bounds difference).
core/tests/expected/structure/*.blocks text eol=lf

# The #355 plain-text writer's golden output (megapdf_write_text(), exact match by
# test_write_text_golden()), written with LF -- same #359 trap as the .blocks goldens above,
# caught the same way on the first real Windows CI run of PR #367.
core/tests/expected/structure/*.txt text eol=lf

# The #357 Markdown writer's golden output (megapdf_write_text() with MEGAPDF_WRITE_MARKDOWN,
# exact match by test_write_markdown_golden()) -- same #359 trap as the .txt goldens above,
# caught the same way on the first real Windows CI run of this PR.
core/tests/expected/structure/*.md text eol=lf
