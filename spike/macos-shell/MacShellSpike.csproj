<Project Sdk="Microsoft.NET.Sdk">

  <!-- ADR-002 spike job 2. Deliberately NOT in MegaPDF.sln: ci.yml runs
       `dotnet build MegaPDF.sln` on windows-latest, and a spike project has no
       business being able to break that. Delete this whole tree once ADR-002
       is decided. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MegaPDF.Spike.MacShell</RootNamespace>
    <AssemblyName>MegaPDF.MacShellSpike</AssemblyName>
    <RuntimeIdentifiers>osx-arm64;osx-x64;win-x64</RuntimeIdentifiers>
    <!-- No .axaml anywhere in this project: the UI is built in code so a first
         build can't fail on XAML compiler/markup wiring, which would tell us
         nothing about the question the spike is asking. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.*" />
    <PackageReference Include="Avalonia.Headless" Version="11.2.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The point of the spike: the shipping engine, unmodified. Note this drags
         in Core's unconditional win-x64 pdfium.dll copy item, which on macOS
         lands a useless DLL beside the app. Harmless here; ADR-002 fact 2 tracks
         the OS condition the real app needs. -->
    <ProjectReference Include="..\..\src\MegaPDF.Core\MegaPDF.Core.csproj" />
  </ItemGroup>

</Project>
